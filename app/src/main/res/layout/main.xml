<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:id="@+id/main_root"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">

	<!-- Toolbar for Project Info and Navigation -->
	<com.google.android.material.appbar.MaterialToolbar
		android:id="@+id/toolbar"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:minHeight="?attr/actionBarSize"
		android:background="?attr/colorSurfaceContainerHigh"
		app:titleTextColor="?attr/colorOnSurface"
		app:subtitleTextColor="?attr/colorOnSurfaceVariant"
		app:navigationIcon="@drawable/icon_arrow_back_round"
		app:navigationIconTint="?attr/colorOnSurface">

		<LinearLayout
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="end"
			android:orientation="horizontal"
			android:gravity="center_vertical">

			<FrameLayout
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_gravity="center_vertical">

				<Button
					android:id="@+id/button4"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					style="?attr/materialIconButtonFilledStyle"
					app:icon="@drawable/device_floppy" />

				<com.google.android.material.progressindicator.CircularProgressIndicator
					android:id="@+id/progressSave"
					android:layout_width="24dp"
					android:layout_height="24dp"
					android:layout_gravity="center"
					android:visibility="gone" />
			</FrameLayout>

			<Button
				android:id="@+id/btnExport"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				style="?attr/materialIconButtonFilledStyle"
				app:icon="@drawable/file_export" />

			<Button
				android:id="@+id/btnTheme"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				style="?attr/materialIconButtonStyle"
				app:icon="@drawable/menu_2"
				app:iconTint="?attr/colorOnSurface" />

		</LinearLayout>

	</com.google.android.material.appbar.MaterialToolbar>

	<!-- Tab Bar: View / Event / Assets -->
	<com.google.android.material.tabs.TabLayout
		android:id="@+id/tabLayout"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		app:tabMode="fixed"
		app:tabGravity="fill"
		app:tabIndicatorColor="?attr/colorPrimary"
		app:tabSelectedTextColor="?attr/colorPrimary"
		app:tabTextColor="?attr/colorOnSurfaceVariant"
		android:background="?attr/colorSurfaceContainerHigh" />

	<!-- ViewPager2 for Fragment control -->
	<androidx.viewpager2.widget.ViewPager2
		android:id="@+id/view_pager"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1" />

</LinearLayout>
