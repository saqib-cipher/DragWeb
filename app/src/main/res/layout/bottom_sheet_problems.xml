<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/colorSurfaceContainerLow"
    android:paddingBottom="24dp">

    <!-- Material 3 Drag Handle -->
    <View
        android:id="@+id/drag_handle"
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <!-- Title Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Problems"
            android:textColor="?attr/colorOnSurface"
            android:textSize="22sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_count_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:textSize="12sp"
            android:textColor="?attr/colorOnPrimaryContainer"
            android:background="@drawable/bg_problems_badge" />
    </LinearLayout>

    <!-- Filter Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_all"
                style="@style/Widget.Dragweb.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All (0)"
                app:checkedIconEnabled="true"
                app:checkedIconTint="@color/text_chip_states"
                app:checkedIcon="@drawable/rounded_check_24"
                android:checked="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_errors"
                style="@style/Widget.Dragweb.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipIcon="@drawable/ic_lint_error"
                app:chipIconEnabled="true"
                android:text="Errors (0)" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_warnings"
                style="@style/Widget.Dragweb.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipIcon="@drawable/ic_lint_warning"
                app:chipIconEnabled="true"
                android:text="Warnings (0)" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_suggestions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipIcon="@drawable/ic_lint_suggestion"
                app:chipIconEnabled="true"
                style="@style/Widget.Dragweb.Chip"
                android:text="Suggestions (0)" />

        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/layout_empty_state"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_check_circle"
            app:tint="?attr/colorPrimary"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/tv_empty_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="No problems found"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Problems List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_problems"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="true"
        android:clipToPadding="false" />

</LinearLayout>
