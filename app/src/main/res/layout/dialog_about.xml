<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:orientation="vertical"
	android:padding="24dp"
	android:gravity="center_horizontal">
	<FrameLayout
		android:layout_width="100dp"
		android:layout_height="100dp">
		<View
			android:layout_width="100dp"
			android:layout_height="100dp"
			android:background="@drawable/bg_empty_state_icon" />
		<ImageView
			android:layout_width="80dp"
			android:layout_height="80dp"
			android:layout_gravity="center"
			android:src="@drawable/app_logo"
			app:tint="?attr/colorOnPrimaryContainer" />
	</FrameLayout>

	<TextView
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:text="@string/app_name"
		android:textSize="22sp"
		android:textStyle="bold"
		android:textColor="?attr/colorOnSurface"
		android:paddingTop="12dp" />

	<TextView
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:text="@string/app_description_short"
		android:textSize="14sp"
		android:textColor="?attr/colorOnSurfaceVariant"
		android:paddingTop="4dp" />

	<TextView
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:text="@string/version_info"
		android:textSize="12sp"
		android:textColor="?attr/colorOnSurfaceVariant"
		android:paddingTop="8dp" />

	<View
		android:layout_width="match_parent"
		android:layout_height="1dp"
		android:background="?attr/colorOutlineVariant"
		android:layout_marginTop="16dp"
		android:layout_marginBottom="16dp" />

	<TextView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:text="DragWeb is a professional no-code web builder for Android. Build modern websites with drag-and-drop layout design, real-time preview, and export clean, production-ready HTML/CSS/JS."
		android:textSize="13sp"
		android:textColor="?attr/colorOnSurfaceVariant"
		android:gravity="center" />

	<TextView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:text="\nFeatures:\n• Drag and drop web widgets\n• Real-time WebView preview\n• CSS-like styling system\n• Visual logic blocks\n• Export HTML/CSS/JS\n• Responsive design testing\n• Project backup and restore"
		android:textSize="12sp"
		android:textColor="?attr/colorOnSurfaceVariant"
		android:paddingTop="12dp" />

		<Button
			android:id="@+id/btnGithub"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/view_github"
			android:layout_marginTop="16dp"
			app:icon="@drawable/brand_github"
			style="@style/Widget.Material3Expressive.Button.OutlinedButton"/>

</LinearLayout>
