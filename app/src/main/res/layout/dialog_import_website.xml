<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical"
	android:padding="24dp">

	<TextView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:text="Import an HTML file and optionally a CSS file to create a DragWeb project automatically."
		android:textSize="14sp"
		android:textColor="?attr/colorOnSurfaceVariant"
		android:lineSpacingMultiplier="1.3"
		android:paddingBottom="16dp" />

	<!-- HTML File Selection -->
	<com.google.android.material.card.MaterialCardView
		android:id="@+id/cardSelectHtml"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		app:cardCornerRadius="12dp"
		app:cardElevation="0dp"
		app:strokeWidth="1dp"
		app:strokeColor="?attr/colorOutline"
		app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
		android:clickable="true"
		android:focusable="true"
		android:foreground="?attr/selectableItemBackground">
		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal"
			android:padding="16dp"
			android:gravity="center_vertical">
			<ImageView
				android:layout_width="24dp"
				android:layout_height="24dp"
				android:src="@drawable/icon_code_round"
				app:tint="?attr/colorPrimary" />
			<LinearLayout
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:orientation="vertical"
				android:layout_marginStart="16dp">
				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="@string/select_html_file"
					android:textSize="14sp"
					android:textStyle="bold"
					android:textColor="?attr/colorOnSurface" />
				<TextView
					android:id="@+id/tvHtmlFileName"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="No file selected"
					android:textSize="12sp"
					android:textColor="?attr/colorOnSurfaceVariant"
					android:layout_marginTop="2dp" />
			</LinearLayout>
		</LinearLayout>
	</com.google.android.material.card.MaterialCardView>

	<!-- CSS File Selection -->
	<com.google.android.material.card.MaterialCardView
		android:id="@+id/cardSelectCss"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="8dp"
		app:cardCornerRadius="12dp"
		app:cardElevation="0dp"
		app:strokeWidth="1dp"
		app:strokeColor="?attr/colorOutlineVariant"
		app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
		android:clickable="true"
		android:focusable="true"
		android:foreground="?attr/selectableItemBackground">
		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal"
			android:padding="16dp"
			android:gravity="center_vertical">
			<ImageView
				android:layout_width="24dp"
				android:layout_height="24dp"
				android:src="@drawable/icon_design_services_round"
				app:tint="?attr/colorSecondary" />
			<LinearLayout
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:orientation="vertical"
				android:layout_marginStart="16dp">
				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="@string/select_css_file"
					android:textSize="14sp"
					android:textStyle="bold"
					android:textColor="?attr/colorOnSurface" />
				<TextView
					android:id="@+id/tvCssFileName"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="No file selected (optional)"
					android:textSize="12sp"
					android:textColor="?attr/colorOnSurfaceVariant"
					android:layout_marginTop="2dp" />
			</LinearLayout>
		</LinearLayout>
	</com.google.android.material.card.MaterialCardView>

	<!-- Project Name -->
	<com.google.android.material.textfield.TextInputLayout
		android:id="@+id/tilImportProjectName"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="16dp"
		android:hint="Project Name"
		app:hintTextColor="?attr/colorOnSurfaceVariant"
		style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
		<com.google.android.material.textfield.TextInputEditText
			android:id="@+id/etImportProjectName"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:inputType="text"
			android:maxLines="1" />
	</com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
