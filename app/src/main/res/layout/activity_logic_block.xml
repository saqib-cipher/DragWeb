<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLogic"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ===== Main content ===== -->
    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="?attr/colorSurface">

        <!-- Top App Bar -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarLogic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurfaceContainerHigh"
            app:title="Logic Blocks"
            app:subtitle="Vertical Stack"
            app:titleTextColor="?attr/colorOnSurface"
            app:subtitleTextColor="?attr/colorOnSurfaceVariant"
            app:navigationIcon="@drawable/icon_arrow_back_round"
            app:navigationIconTint="?attr/colorOnSurface"
            app:menu="@menu/menu_logic_block" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayoutMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurfaceContainerHigh"
            app:tabIndicatorAnimationMode="elastic"
            app:tabSelectedTextColor="?attr/colorPrimary"
            app:tabTextColor="?attr/colorOnSurfaceVariant"
            app:tabIndicatorColor="?attr/colorPrimary">
            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Style" />
            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Source" />
        </com.google.android.material.tabs.TabLayout>

        <!-- ===== Block count strip ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="6dp"
            android:background="?attr/colorSurfaceContainerHigh">

            <TextView
                android:id="@+id/tvBlockCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0 blocks"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:paddingStart="6dp" />



            <LinearLayout
                android:id="@+id/btnSaveToCollection"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_drop_target_save"
                android:gravity="center"
                android:orientation="horizontal"
                android:elevation="1dp">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/icon_save_round"
                    app:tint="#FFFFFF" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnBlockDuplicate"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_drop_target_duplicate"
                android:gravity="center"
                android:orientation="horizontal"
                android:elevation="1dp">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/icon_copy_all_round"
                    app:tint="#FFFFFF" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnBlockDelete"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_drop_target_delete"
                android:gravity="center"
                android:orientation="horizontal"
                android:elevation="2dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/icon_delete_round"
                    app:tint="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Drop to Delete"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== Workspace + bottom delete bar ===== -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <sketchweb.gl.WorkspaceView
                android:id="@+id/workspaceView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_block_canvas" />

            <!-- Delete bar floats at the bottom of the workspace; release a
                 dragged block on it to remove. -->



            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabBlockPalette"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="20dp"
                app:backgroundTint="?attr/colorPrimary"
                android:contentDescription="Toggle palette"
                app:srcCompat="@drawable/icon_widgets_round"
                app:fabSize="normal"
                app:tint="?attr/colorOnPrimary" />
        </FrameLayout>

        <!-- ===== Bottom Palette: Blocks (left) + Categories (right) ===== -->
        <LinearLayout
            android:id="@+id/palettePanel"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:orientation="horizontal"
            android:background="?attr/colorSurfaceContainer"
            android:elevation="6dp">

            <androidx.core.widget.NestedScrollView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:scrollbars="none"
                android:background="?attr/colorSurfaceContainerLow">

                <LinearLayout
                    android:id="@+id/blockPaletteContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="6dp" />
            </androidx.core.widget.NestedScrollView>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="?attr/colorOutlineVariant" />

            <androidx.core.widget.NestedScrollView
                android:layout_width="96dp"
                android:layout_height="match_parent"
                android:scrollbars="none"
                android:background="?attr/colorSurfaceContainerHigh">

                <LinearLayout
                    android:id="@+id/categoryListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="4dp" />
            </androidx.core.widget.NestedScrollView>
        </LinearLayout>

    </LinearLayout>

    <!-- ===== Right-side collection drawer (kept for back-compat) ===== -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:fitsSystemWindows="true"
        app:cardElevation="6dp"
        app:cardCornerRadius="0dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Block Collection"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:padding="14dp"
                android:background="?attr/colorSurfaceContainerHigh" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <!-- Drawer drop targets removed as per user request -->
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/colorOutlineVariant"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Saved Collections"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:padding="12dp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/collectionList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="20dp" />
            </ScrollView>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.drawerlayout.widget.DrawerLayout>
