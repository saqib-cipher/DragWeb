<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/_main"
	android:layout_width="match_parent"
	android:layout_height="match_parent">

	<!-- Main Content Area inside Editor -->
	<LinearLayout
		android:id="@+id/main"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:orientation="vertical"
		android:background="?attr/colorSurface">

		<!-- Top Bar -->
		<LinearLayout
			android:id="@+id/topBar"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="2dp"
			android:gravity="center_vertical"
			android:orientation="horizontal"
			android:background="?attr/colorSurfaceContainerHigh">
			<Button
				android:id="@+id/btnDrawer"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				style="?attr/materialIconButtonStyle"
				app:icon="@drawable/layout_grid_add" />

			<!-- Page selector spinner -->
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/page_name_container"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:layout_marginStart="12dp"
				android:layout_marginEnd="8dp"
				android:clickable="true"
				app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
				app:contentPadding="8dp">

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:gravity="center_vertical"
					android:paddingVertical="2dp">

					<TextView
						android:id="@+id/page_name"
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_marginHorizontal="8dp"
						android:layout_weight="1"
						android:singleLine="true"
						android:text="main"
						android:textAppearance="?attr/textAppearanceBodyMedium" />

					<ImageView
						android:layout_width="20dp"
						android:layout_height="20dp"
						android:layout_marginEnd="4dp"
						android:src="@drawable/rounded_arrow_drop_down_24"
						app:tint="?attr/colorControlNormal" />

				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>

			<Button
				android:id="@+id/btnUndo"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:enabled="false"
				style="?attr/materialIconButtonStyle"
				app:icon="@drawable/icon_undo_round" />
			<Button
				android:id="@+id/btnRedo"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:enabled="false"
				style="?attr/materialIconButtonStyle"
				app:icon="@drawable/icon_redo_round" />
			<Button
				android:id="@+id/btnHierarchy"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				style="?attr/materialIconButtonStyle"
				app:icon="@drawable/layout_list" />
		</LinearLayout>

		<!-- Main Area: Canvas + Side Panels -->
		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="0dp"
			android:layout_weight="1"
			android:orientation="horizontal">

			<!-- Center pane: Design Canvas -->
			<LinearLayout
				android:layout_width="0dp"
				android:layout_height="match_parent"
				android:layout_weight="1"
				android:padding="4dp"
				android:orientation="vertical">
				<FrameLayout
					android:layout_width="match_parent"
					android:layout_height="match_parent">

					<!-- Canvas area (View tab) -->
					<androidx.core.widget.NestedScrollView
						android:id="@+id/vscroll2"
						android:layout_width="match_parent"
						android:layout_height="match_parent">
						<LinearLayout
							android:id="@+id/screen"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:padding="4dp"
							android:gravity="center_horizontal|top"
							android:orientation="vertical"
							android:background="@color/lighter_grey"
							android:elevation="2dp"
							android:minHeight="540dp" />
					</androidx.core.widget.NestedScrollView>

					<!-- Loading state -->
					<LinearLayout
						android:id="@+id/layoutLoading"
						android:layout_width="match_parent"
						android:layout_height="match_parent"
						android:gravity="center"
						android:orientation="vertical"
						android:background="?attr/colorSurface"
						android:visibility="gone">
						<com.google.android.material.progressindicator.CircularProgressIndicator
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:indeterminate="true" />
						<TextView
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginTop="12dp"
							android:text="Loading page..."
							android:textSize="12sp"
							android:textColor="?attr/colorOnSurfaceVariant" />
					</LinearLayout>

				</FrameLayout>
			</LinearLayout>

		</LinearLayout>

		<!-- Bottom Panel: Style Management -->
		<LinearLayout
			android:id="@+id/bottomPanel"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:background="?attr/colorSurfaceContainerHigh"
			android:padding="6dp">

			<!-- Style items horizontal list -->
			<androidx.recyclerview.widget.RecyclerView
				android:id="@+id/recyclerview3"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="horizontal"
				tools:listitem="@layout/design" />

			<!-- Tabs: Basic / Layout / Text / More -->
			<com.google.android.material.chip.ChipGroup
				android:id="@+id/chipGroupBottom"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				app:singleSelection="true"
				app:selectionRequired="true"
				android:layout_marginTop="4dp"
				android:layout_marginBottom="4dp">
				<com.google.android.material.chip.Chip
					android:id="@+id/chipBasic"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Basic"
					android:textSize="11sp"
					style="@style/Widget.Material3.Chip.Filter"
					android:checked="true" />
				<com.google.android.material.chip.Chip
					android:id="@+id/chipLayout"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Layout"
					android:textSize="11sp"
					style="@style/Widget.Material3.Chip.Filter" />
				<com.google.android.material.chip.Chip
					android:id="@+id/chipText"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Text"
					android:textSize="11sp"
					style="@style/Widget.Material3.Chip.Filter" />
				<com.google.android.material.chip.Chip
					android:id="@+id/chipMore"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="More"
					android:textSize="11sp"
					style="@style/Widget.Material3.Chip.Filter" />
			</com.google.android.material.chip.ChipGroup>

			<!-- Bottom row: Selected widget & actions -->
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="horizontal"
				android:gravity="center_vertical">

				<!-- Card for selected widget and controls -->
				<com.google.android.material.card.MaterialCardView
					android:id="@+id/cardSelectedWidget"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:layout_marginEnd="8dp"
					app:cardCornerRadius="8dp"
					app:cardElevation="0dp"
					app:strokeWidth="1dp"
					app:strokeColor="?attr/colorOutlineVariant"
					app:cardBackgroundColor="?attr/colorSurfaceContainerLow">

					<LinearLayout
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:orientation="horizontal"
						android:gravity="center_vertical"
						android:padding="4dp">

						<!-- Clickable area to open the widget selection dropdown popup -->
						<LinearLayout
							android:id="@+id/btnWidgetDropdown"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:layout_weight="1"
							android:orientation="horizontal"
							android:gravity="center_vertical"
							android:clickable="true"
							android:focusable="true"
							android:background="?android:attr/selectableItemBackground"
							android:padding="6dp">

							<TextView
								android:id="@+id/tvSelectedWidgetName"
								android:layout_width="0dp"
								android:layout_height="wrap_content"
								android:layout_weight="1"
								android:text="body (screen)"
								android:textSize="12sp"
								android:textStyle="bold"
								android:singleLine="true"
								android:ellipsize="end"
								android:textColor="?attr/colorOnSurface" />

							<ImageView
								android:layout_width="16dp"
								android:layout_height="16dp"
								android:layout_marginStart="4dp"
								android:src="@drawable/rounded_arrow_drop_down_24"
								app:tint="?attr/colorOnSurfaceVariant" />
						</LinearLayout>

						<View
							android:layout_width="1dp"
							android:layout_height="20dp"
							android:layout_marginHorizontal="4dp"
							android:background="?attr/colorOutlineVariant" />

						<!-- Toggle Lock Button -->
						<ImageView
							android:id="@+id/btnBottomLock"
							android:layout_width="28dp"
							android:layout_height="28dp"
							android:padding="4dp"
							android:clickable="true"
							android:focusable="true"
							android:background="?android:attr/selectableItemBackgroundBorderless"
							android:src="@drawable/outline_lock_open_24"
							app:tint="?attr/colorOnSurfaceVariant" />

						<!-- Toggle Hide Button -->
						<ImageView
							android:id="@+id/btnBottomHide"
							android:layout_width="28dp"
							android:layout_height="28dp"
							android:padding="4dp"
							android:clickable="true"
							android:focusable="true"
							android:background="?android:attr/selectableItemBackgroundBorderless"
							android:src="@android:drawable/ic_menu_view"
							app:tint="?attr/colorOnSurfaceVariant" />

					</LinearLayout>
				</com.google.android.material.card.MaterialCardView>

				<!-- Dummy textview2 to prevent null pointer errors -->
				<TextView
					android:id="@+id/textview2"
					android:layout_width="0dp"
					android:layout_height="0dp"
					android:visibility="gone" />

				<!-- Copy widget button -->
				<Button
					android:id="@+id/btnCopyWidget"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					style="?attr/materialIconButtonStyle"
					app:icon="@drawable/copy_plus" />

				<Button
					android:id="@+id/delete"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:enabled="false"
					style="?attr/materialIconButtonFilledStyle"
					app:icon="@drawable/trash" />



				<Button
					android:id="@+id/button5"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					style="?attr/materialIconButtonFilledStyle"
					app:icon="@drawable/world" />

			</LinearLayout>
		</LinearLayout>
	</LinearLayout>

	<!-- Left Drawer: Widget Palette + Settings -->
	<LinearLayout
		android:id="@+id/drawerContent"
		android:layout_width="300dp"
		android:layout_height="match_parent"
		android:layout_gravity="start"
		android:clickable="true"
		android:focusable="true"
		android:background="?attr/colorSurface"
		android:orientation="vertical">

		<!-- Search bar for widgets -->
		<com.google.android.material.textfield.TextInputLayout
			android:id="@+id/searchWidgetLayout"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginStart="8dp"
			android:layout_marginEnd="8dp"
			android:layout_marginTop="8dp"
			android:hint="Search widgets..."
			app:boxCornerRadiusTopStart="8dp"
			app:boxCornerRadiusTopEnd="8dp"
			app:boxCornerRadiusBottomStart="8dp"
			app:boxCornerRadiusBottomEnd="8dp"
			style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense">
			<com.google.android.material.textfield.TextInputEditText
				android:id="@+id/etSearchWidget"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:textSize="13sp"
				android:inputType="text"
				android:maxLines="1" />
		</com.google.android.material.textfield.TextInputLayout>

		<!-- Widget category chips in drawer -->
		<HorizontalScrollView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:scrollbars="none"
			android:layout_marginTop="4dp"
			android:paddingLeft="8dp"
			android:paddingRight="8dp">
			<com.google.android.material.chip.ChipGroup
				android:id="@+id/chipGroupDrawerCategories"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				app:singleSelection="true"
				app:singleLine="true">
				<com.google.android.material.chip.Chip
					android:id="@+id/chipDrawerAll"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="All"
					android:textSize="11sp"
					android:checked="true"
					style="@style/Widget.Material3.Chip.Filter" />
				<com.google.android.material.chip.Chip
					android:id="@+id/chipDrawerLayout"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Layout"
					android:textSize="11sp"
					style="@style/Widget.Material3.Chip.Filter" />
				<com.google.android.material.chip.Chip
					android:id="@+id/chipDrawerBasic"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Basic"
					android:textSize="11sp"
					style="@style/Widget.Material3.Chip.Filter" />
				<com.google.android.material.chip.Chip
					android:id="@+id/chipDrawerForm"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Form"
					android:textSize="11sp"
					style="@style/Widget.Material3.Chip.Filter" />
			</com.google.android.material.chip.ChipGroup>
		</HorizontalScrollView>

		<!-- Widget list in drawer (vertical) with bigger text -->
		<androidx.recyclerview.widget.RecyclerView
			android:id="@+id/rvDrawerWidgets"
			android:layout_width="match_parent"
			android:layout_height="0dp"
			android:layout_weight="1"
			android:layout_marginTop="4dp"
			android:paddingLeft="8dp"
			android:paddingRight="8dp"
			android:clipToPadding="false"
			tools:listitem="@layout/widgets" />

	</LinearLayout>

	<!-- Right Drawer: Layout Hierarchy -->
	<LinearLayout
		android:id="@+id/rightDrawerContent"
		android:layout_width="300dp"
		android:layout_height="match_parent"
		android:layout_gravity="end"
		android:clickable="true"
		android:focusable="true"
		android:background="?attr/colorSurface"
		android:orientation="vertical">

		<!-- Drawer Header -->
		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal"
			android:gravity="center_vertical"
			android:padding="12dp">

			<TextView
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:text="Layout Hierarchy"
				android:textSize="16sp"
				android:textStyle="bold"
				android:textColor="?attr/colorOnSurface" />

			<Button
				android:id="@+id/btnCloseHierarchy"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				style="?attr/materialIconButtonStyle"
				app:icon="@drawable/x"
				app:iconTint="?attr/colorOnSurface" />
		</LinearLayout>

		<View
			android:layout_width="match_parent"
			android:layout_height="1dp"
			android:background="?attr/colorOutlineVariant" />

		<!-- Search bar for hierarchy -->
		<com.google.android.material.textfield.TextInputLayout
			android:id="@+id/searchHierarchyLayout"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginStart="12dp"
			android:layout_marginEnd="12dp"
			android:layout_marginTop="8dp"
			android:hint="Find widget..."
			app:boxCornerRadiusTopStart="8dp"
			app:boxCornerRadiusTopEnd="8dp"
			app:boxCornerRadiusBottomStart="8dp"
			app:boxCornerRadiusBottomEnd="8dp"
			style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense">
			<com.google.android.material.textfield.TextInputEditText
				android:id="@+id/etSearchHierarchy"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:textSize="13sp"
				android:inputType="text"
				android:maxLines="1" />
		</com.google.android.material.textfield.TextInputLayout>

		<!-- Hierarchy list: Horizontal + Vertical scroll container -->
		<HorizontalScrollView
			android:layout_width="match_parent"
			android:layout_height="0dp"
			android:layout_weight="1"
			android:layout_marginTop="8dp"
			android:scrollbars="horizontal">
			
			<androidx.recyclerview.widget.RecyclerView
				android:id="@+id/recyclerviewRightPanel"
				android:layout_width="wrap_content"
				android:layout_height="match_parent"
				android:paddingStart="4dp"
				android:paddingEnd="16dp"
				android:clipToPadding="false" />
		</HorizontalScrollView>

	</LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
