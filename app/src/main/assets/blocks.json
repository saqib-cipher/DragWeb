{
  "version": 2,
  "format": "custom-block-template",
  "description": "Sketchware-style custom block templates for DragWeb. Each block has an id, a human-readable display string, a template that emits static HTML or CSS, and a category (HTML or CSS). Tokens: %s string, %d number, %1$s/%2$s positional, %m.id %m.class %m.tag %m.file %m.section selectors. Runtime DOM-mutation blocks (setText, setHTML, showElement, addClass, etc.) have been removed because they cannot be expressed as static code generation.",
  "blocks": [
    {
      "id": "navbar_link",
      "display": "Add navbar link %1$s to %2$s",
      "template": "<li><a href='%1$s'>%2$s</a></li>",
      "category": "HTML"
    },
    {
      "id": "menu_link",
      "display": "Add menu link %1$s to %2$s",
      "template": "<li><a href='%1$s'>%2$s</a></li>",
      "category": "HTML"
    },
    {
      "id": "section_link",
      "display": "Link to section #%1$s labelled %2$s",
      "template": "<a href='#%1$s'>%2$s</a>",
      "category": "HTML"
    },
    {
      "id": "page_link",
      "display": "Link to page %m.file labelled %s",
      "template": "<a href='%1$s'>%2$s</a>",
      "category": "HTML"
    },
    {
      "id": "external_link",
      "display": "External link %s labelled %s",
      "template": "<a href='%1$s' target='_blank' rel='noopener'>%2$s</a>",
      "category": "HTML"
    },
    {
      "id": "button_block",
      "display": "Button labelled %s",
      "template": "<button>%1$s</button>",
      "category": "HTML"
    },
    {
      "id": "button_class",
      "display": "Button %s with class %s",
      "template": "<button class='%2$s'>%1$s</button>",
      "category": "HTML"
    },
    {
      "id": "image_block",
      "display": "Image from %s",
      "template": "<img src='%1$s' alt=''>",
      "category": "HTML"
    },
    {
      "id": "image_with_alt",
      "display": "Image %s with alt %s",
      "template": "<img src='%1$s' alt='%2$s'>",
      "category": "HTML"
    },
    {
      "id": "paragraph_block",
      "display": "Paragraph %s",
      "template": "<p>%1$s</p>",
      "category": "HTML"
    },
    {
      "id": "heading_block",
      "display": "Heading %d - %s",
      "template": "<h%1$d>%2$s</h%1$d>",
      "category": "HTML"
    },
    {
      "id": "section_block",
      "display": "Section #%s containing %s",
      "template": "<section id='%1$s'>%2$s</section>",
      "category": "HTML"
    },
    {
      "id": "div_class_text",
      "display": "Div class %s with text %s",
      "template": "<div class='%1$s'>%2$s</div>",
      "category": "HTML"
    },
    {
      "id": "video_block",
      "display": "Video from %s",
      "template": "<video src='%1$s' controls></video>",
      "category": "HTML"
    },
    {
      "id": "iframe_block",
      "display": "Embed iframe from %s",
      "template": "<iframe src='%1$s' frameborder='0'></iframe>",
      "category": "HTML"
    },

    {
      "id": "class_color",
      "display": "Set class %m.class color to %s",
      "template": ".%1$s{color:%2$s;}",
      "category": "CSS"
    },
    {
      "id": "class_background",
      "display": "Set class %m.class background to %s",
      "template": ".%1$s{background:%2$s;}",
      "category": "CSS"
    },
    {
      "id": "class_padding",
      "display": "Set class %m.class padding to %s",
      "template": ".%1$s{padding:%2$s;}",
      "category": "CSS"
    },
    {
      "id": "class_margin",
      "display": "Set class %m.class margin to %s",
      "template": ".%1$s{margin:%2$s;}",
      "category": "CSS"
    },
    {
      "id": "class_radius",
      "display": "Set class %m.class border-radius to %s",
      "template": ".%1$s{border-radius:%2$s;}",
      "category": "CSS"
    },
    {
      "id": "class_font_size",
      "display": "Set class %m.class font-size to %s",
      "template": ".%1$s{font-size:%2$s;}",
      "category": "CSS"
    },
    {
      "id": "class_text_align",
      "display": "Set class %m.class text-align to %s",
      "template": ".%1$s{text-align:%2$s;}",
      "category": "CSS"
    },
    {
      "id": "class_display",
      "display": "Set class %m.class display to %s",
      "template": ".%1$s{display:%2$s;}",
      "category": "CSS"
    },
    {
      "id": "id_width",
      "display": "Set id #%m.id width to %s",
      "template": "#%1$s{width:%2$s;}",
      "category": "CSS"
    },
    {
      "id": "id_height",
      "display": "Set id #%m.id height to %s",
      "template": "#%1$s{height:%2$s;}",
      "category": "CSS"
    },
    {
      "id": "id_color",
      "display": "Set id #%m.id color to %s",
      "template": "#%1$s{color:%2$s;}",
      "category": "CSS"
    },
    {
      "id": "id_background",
      "display": "Set id #%m.id background to %s",
      "template": "#%1$s{background:%2$s;}",
      "category": "CSS"
    },
    {
      "id": "tag_font_size",
      "display": "Set tag %m.tag font-size to %s",
      "template": "%1$s{font-size:%2$s;}",
      "category": "CSS"
    },
    {
      "id": "tag_color",
      "display": "Set tag %m.tag color to %s",
      "template": "%1$s{color:%2$s;}",
      "category": "CSS"
    },
    {
      "id": "tag_margin",
      "display": "Set tag %m.tag margin to %s",
      "template": "%1$s{margin:%2$s;}",
      "category": "CSS"
    },
    {
      "id": "hover_color",
      "display": "On hover for class %m.class, color %s",
      "template": ".%1$s:hover{color:%2$s;}",
      "category": "CSS"
    },
    {
      "id": "hover_background",
      "display": "On hover for class %m.class, background %s",
      "template": ".%1$s:hover{background:%2$s;}",
      "category": "CSS"
    },
    {
      "id": "media_max_width",
      "display": "Below %dpx, class %m.class display %s",
      "template": "@media (max-width:%1$dpx){.%2$s{display:%3$s;}}",
      "category": "CSS"
    }
  ]
}
