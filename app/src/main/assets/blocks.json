[
  { "id": "groupBlock", "category": "meta", "shape": "cblock", "color": "#37474F",
    "label": "▾ group %s", "code": "/* <%s> */ %m.space /* </%s> */",
    "inputs": [ { "id": "name", "type": "text", "default": "navbar" } ] },
  { "id": "commentBlock", "category": "meta", "shape": "stack", "color": "#546E7A",
    "label": "// %s", "code": "/* %s */",
    "inputs": [ { "id": "text", "type": "text", "default": "comment" } ] },

  { "id": "cssSelector", "category": "css", "shape": "cblock", "color": "#1976D2",
    "label": "%s {", "code": "%s { %m.space }",
    "inputs": [
      { "id": "selector", "type": "selector", "selector": "any", "default": ".container" }
    ] },
  { "id": "cssHover", "category": "css", "shape": "cblock", "color": "#1976D2",
    "label": "%s :hover {", "code": "%s:hover { %m.space }",
    "inputs": [ { "id": "selector", "type": "selector", "selector": "any", "default": "a" } ] },
  { "id": "cssFocus", "category": "css", "shape": "cblock", "color": "#1976D2",
    "label": "%s :focus {", "code": "%s:focus { %m.space }",
    "inputs": [ { "id": "selector", "type": "selector", "selector": "any", "default": "input" } ] },
  { "id": "cssActive", "category": "css", "shape": "cblock", "color": "#1976D2",
    "label": "%s :active {", "code": "%s:active { %m.space }",
    "inputs": [ { "id": "selector", "type": "selector", "selector": "any", "default": "button" } ] },
  { "id": "cssVisited", "category": "css", "shape": "cblock", "color": "#1976D2",
    "label": "%s :visited {", "code": "%s:visited { %m.space }",
    "inputs": [ { "id": "selector", "type": "selector", "selector": "any", "default": "a" } ] },
  { "id": "cssBefore", "category": "css", "shape": "cblock", "color": "#1976D2",
    "label": "%s ::before {", "code": "%s::before { %m.space }",
    "inputs": [ { "id": "selector", "type": "selector", "selector": "any", "default": "a" } ] },
  { "id": "cssAfter", "category": "css", "shape": "cblock", "color": "#1976D2",
    "label": "%s ::after {", "code": "%s::after { %m.space }",
    "inputs": [ { "id": "selector", "type": "selector", "selector": "any", "default": "a" } ] },
  { "id": "cssFirstChild", "category": "css", "shape": "cblock", "color": "#1976D2",
    "label": "%s :first-child {", "code": "%s:first-child { %m.space }",
    "inputs": [ { "id": "selector", "type": "selector", "selector": "any", "default": "li" } ] },
  { "id": "cssLastChild", "category": "css", "shape": "cblock", "color": "#1976D2",
    "label": "%s :last-child {", "code": "%s:last-child { %m.space }",
    "inputs": [ { "id": "selector", "type": "selector", "selector": "any", "default": "li" } ] },
  { "id": "cssNthChild", "category": "css", "shape": "cblock", "color": "#1976D2",
    "label": "%s :nth-child(%n) {", "code": "%s:nth-child(%n) { %m.space }",
    "inputs": [
      { "id": "selector", "type": "selector", "selector": "any", "default": "li" },
      { "id": "n", "type": "number", "default": "1" }
    ] },
  { "id": "cssMediaQuery", "category": "css", "shape": "cblock", "color": "#1565C0",
    "label": "@media (max-width: %n px) {", "code": "@media (max-width: %npx) { %m.space }",
    "inputs": [ { "id": "max", "type": "number", "default": "768" } ] },

  { "id": "setDisplay", "category": "css", "shape": "stack", "color": "#2196F3",
    "label": "display", "code": "display: %m.display;",
    "inputs": [ { "id": "value", "type": "dropdown", "paramType": "display", "default": "block" } ] },
  { "id": "setPosition", "category": "css", "shape": "stack", "color": "#2196F3",
    "label": "position", "code": "position: %m.position;",
    "inputs": [ { "id": "value", "type": "dropdown", "paramType": "position", "default": "static" } ] },
  { "id": "setOverflow", "category": "css", "shape": "stack", "color": "#2196F3",
    "label": "overflow", "code": "overflow: %m.overflow;",
    "inputs": [ { "id": "value", "type": "dropdown", "paramType": "overflow", "default": "visible" } ] },
  { "id": "setColor", "category": "css", "shape": "stack", "color": "#2196F3",
    "label": "color", "code": "color: %m.color;",
    "inputs": [ { "id": "value", "type": "color", "default": "#000000" } ] },
  { "id": "setBackground", "category": "css", "shape": "stack", "color": "#2196F3",
    "label": "background", "code": "background: %m.color;",
    "inputs": [ { "id": "value", "type": "color", "default": "#FFFFFF" } ] },
  { "id": "setBackgroundImage", "category": "css", "shape": "stack", "color": "#2196F3",
    "label": "background-image url", "code": "background-image: url(%s);",
    "inputs": [ { "id": "value", "type": "text", "default": "" } ] },
  { "id": "setWidth", "category": "css", "shape": "stack", "color": "#2196F3",
    "label": "width", "code": "width: %n%m.unit;",
    "inputs": [
      { "id": "value", "type": "number", "default": "100" },
      { "id": "unit", "type": "dropdown", "default": "px", "options": ["px","%","rem","em","vw","vh","auto"] }
    ] },
  { "id": "setHeight", "category": "css", "shape": "stack", "color": "#2196F3",
    "label": "height", "code": "height: %n%m.unit;",
    "inputs": [
      { "id": "value", "type": "number", "default": "100" },
      { "id": "unit", "type": "dropdown", "default": "px", "options": ["px","%","rem","em","vw","vh","auto"] }
    ] },
  { "id": "setMaxWidth", "category": "css", "shape": "stack", "color": "#2196F3",
    "label": "max-width", "code": "max-width: %n%m.unit;",
    "inputs": [
      { "id": "value", "type": "number", "default": "100" },
      { "id": "unit", "type": "dropdown", "default": "%", "options": ["px","%","rem","em","vw","vh","none"] }
    ] },
  { "id": "setMaxHeight", "category": "css", "shape": "stack", "color": "#2196F3",
    "label": "max-height", "code": "max-height: %n%m.unit;",
    "inputs": [
      { "id": "value", "type": "number", "default": "100" },
      { "id": "unit", "type": "dropdown", "default": "%", "options": ["px","%","rem","em","vw","vh","none"] }
    ] },
  { "id": "setMinWidth", "category": "css", "shape": "stack", "color": "#2196F3",
    "label": "min-width", "code": "min-width: %n%m.unit;",
    "inputs": [
      { "id": "value", "type": "number", "default": "0" },
      { "id": "unit", "type": "dropdown", "default": "px", "options": ["px","%","rem","em","vw","vh"] }
    ] },
  { "id": "setMinHeight", "category": "css", "shape": "stack", "color": "#2196F3",
    "label": "min-height", "code": "min-height: %n%m.unit;",
    "inputs": [
      { "id": "value", "type": "number", "default": "0" },
      { "id": "unit", "type": "dropdown", "default": "px", "options": ["px","%","rem","em","vw","vh"] }
    ] },
  { "id": "setMargin", "category": "css", "shape": "stack", "color": "#2196F3",
    "label": "margin", "code": "margin: %n%m.unit;",
    "inputs": [
      { "id": "value", "type": "number", "default": "0" },
      { "id": "unit", "type": "dropdown", "default": "px", "options": ["px","%","rem","em","auto"] }
    ] },
  { "id": "setPadding", "category": "css", "shape": "stack", "color": "#2196F3",
    "label": "padding", "code": "padding: %n%m.unit;",
    "inputs": [
      { "id": "value", "type": "number", "default": "0" },
      { "id": "unit", "type": "dropdown", "default": "px", "options": ["px","%","rem","em"] }
    ] },
  { "id": "setBorder", "category": "css", "shape": "stack", "color": "#2196F3",
    "label": "border", "code": "border: %n%m.unit solid %m.color;",
    "inputs": [
      { "id": "size", "type": "number", "default": "1" },
      { "id": "unit", "type": "dropdown", "default": "px", "options": ["px","rem","em"] },
      { "id": "color", "type": "color", "default": "#000000" }
    ] },
  { "id": "setRadius", "category": "css", "shape": "stack", "color": "#2196F3",
    "label": "border-radius", "code": "border-radius: %n%m.unit;",
    "inputs": [
      { "id": "value", "type": "number", "default": "8" },
      { "id": "unit", "type": "dropdown", "default": "px", "options": ["px","%","rem"] }
    ] },
  { "id": "setBoxShadow", "category": "css", "shape": "stack", "color": "#2196F3",
    "label": "box-shadow", "code": "box-shadow: %npx %npx %npx %m.color;",
    "inputs": [
      { "id": "x", "type": "number", "default": "0" },
      { "id": "y", "type": "number", "default": "2" },
      { "id": "blur", "type": "number", "default": "8" },
      { "id": "color", "type": "color", "default": "#00000033" }
    ] },
  { "id": "setFontSize", "category": "css", "shape": "stack", "color": "#2196F3",
    "label": "font-size", "code": "font-size: %n%m.unit;",
    "inputs": [
      { "id": "value", "type": "number", "default": "16" },
      { "id": "unit", "type": "dropdown", "default": "px", "options": ["px","rem","em","%"] }
    ] },
  { "id": "setFontFamily", "category": "css", "shape": "stack", "color": "#2196F3",
    "label": "font-family", "code": "font-family: %s;",
    "inputs": [ { "id": "value", "type": "text", "default": "sans-serif" } ] },
  { "id": "setFontWeight", "category": "css", "shape": "stack", "color": "#2196F3",
    "label": "font-weight", "code": "font-weight: %m.fontWeight;",
    "inputs": [ { "id": "value", "type": "dropdown", "paramType": "fontWeight", "default": "400" } ] },
  { "id": "setFontStyle", "category": "css", "shape": "stack", "color": "#2196F3",
    "label": "font-style", "code": "font-style: %m.fontStyle;",
    "inputs": [ { "id": "value", "type": "dropdown", "paramType": "fontStyle", "default": "normal" } ] },
  { "id": "setTextAlign", "category": "css", "shape": "stack", "color": "#2196F3",
    "label": "text-align", "code": "text-align: %m.textAlign;",
    "inputs": [ { "id": "value", "type": "dropdown", "paramType": "textAlign", "default": "left" } ] },
  { "id": "setTextDecoration", "category": "css", "shape": "stack", "color": "#2196F3",
    "label": "text-decoration", "code": "text-decoration: %m.textDecoration;",
    "inputs": [ { "id": "value", "type": "dropdown", "paramType": "textDecoration", "default": "none" } ] },
  { "id": "setLineHeight", "category": "css", "shape": "stack", "color": "#2196F3",
    "label": "line-height", "code": "line-height: %n;",
    "inputs": [ { "id": "value", "type": "number", "default": "1.4" } ] },
  { "id": "setLetterSpacing", "category": "css", "shape": "stack", "color": "#2196F3",
    "label": "letter-spacing", "code": "letter-spacing: %n%m.unit;",
    "inputs": [
      { "id": "value", "type": "number", "default": "0" },
      { "id": "unit", "type": "dropdown", "default": "px", "options": ["px","em","rem"] }
    ] },
  { "id": "setOpacity", "category": "css", "shape": "stack", "color": "#2196F3",
    "label": "opacity", "code": "opacity: %n;",
    "inputs": [ { "id": "value", "type": "number", "default": "1" } ] },
  { "id": "setZIndex", "category": "css", "shape": "stack", "color": "#2196F3",
    "label": "z-index", "code": "z-index: %n;",
    "inputs": [ { "id": "value", "type": "number", "default": "0" } ] },
  { "id": "setCursor", "category": "css", "shape": "stack", "color": "#2196F3",
    "label": "cursor", "code": "cursor: %m.cursor;",
    "inputs": [ { "id": "value", "type": "dropdown", "paramType": "cursor", "default": "default" } ] },
  { "id": "setFlexDirection", "category": "css", "shape": "stack", "color": "#2196F3",
    "label": "flex-direction", "code": "flex-direction: %m.flexDirection;",
    "inputs": [ { "id": "value", "type": "dropdown", "paramType": "flexDirection", "default": "row" } ] },
  { "id": "setJustifyContent", "category": "css", "shape": "stack", "color": "#2196F3",
    "label": "justify-content", "code": "justify-content: %m.justifyContent;",
    "inputs": [ { "id": "value", "type": "dropdown", "paramType": "justifyContent", "default": "flex-start" } ] },
  { "id": "setAlignItems", "category": "css", "shape": "stack", "color": "#2196F3",
    "label": "align-items", "code": "align-items: %m.alignItems;",
    "inputs": [ { "id": "value", "type": "dropdown", "paramType": "alignItems", "default": "stretch" } ] },
  { "id": "setGap", "category": "css", "shape": "stack", "color": "#2196F3",
    "label": "gap", "code": "gap: %n%m.unit;",
    "inputs": [
      { "id": "value", "type": "number", "default": "8" },
      { "id": "unit", "type": "dropdown", "default": "px", "options": ["px","%","rem","em"] }
    ] },
  { "id": "setGridTemplateColumns", "category": "css", "shape": "stack", "color": "#2196F3",
    "label": "grid columns", "code": "grid-template-columns: %s;",
    "inputs": [ { "id": "value", "type": "text", "default": "1fr 1fr" } ] },
  { "id": "setTransform", "category": "css", "shape": "stack", "color": "#2196F3",
    "label": "transform", "code": "transform: %s;",
    "inputs": [ { "id": "value", "type": "text", "default": "none" } ] },
  { "id": "setFilter", "category": "css", "shape": "stack", "color": "#2196F3",
    "label": "filter", "code": "filter: %s;",
    "inputs": [ { "id": "value", "type": "text", "default": "none" } ] },

  { "id": "animateFadeIn", "category": "animation", "shape": "stack", "color": "#9C27B0",
    "label": "animate fade-in", "code": "animation: fadeIn %ns;",
    "inputs": [ { "id": "duration", "type": "number", "default": "1" } ] },
  { "id": "animateFadeOut", "category": "animation", "shape": "stack", "color": "#9C27B0",
    "label": "animate fade-out", "code": "animation: fadeOut %ns;",
    "inputs": [ { "id": "duration", "type": "number", "default": "1" } ] },
  { "id": "animateSlideIn", "category": "animation", "shape": "stack", "color": "#9C27B0",
    "label": "animate slide-in", "code": "animation: slideIn %ns;",
    "inputs": [ { "id": "duration", "type": "number", "default": "1" } ] },
  { "id": "animateSlideOut", "category": "animation", "shape": "stack", "color": "#9C27B0",
    "label": "animate slide-out", "code": "animation: slideOut %ns;",
    "inputs": [ { "id": "duration", "type": "number", "default": "1" } ] },
  { "id": "animateBounce", "category": "animation", "shape": "stack", "color": "#9C27B0",
    "label": "animate bounce", "code": "animation: bounce %ns;",
    "inputs": [ { "id": "duration", "type": "number", "default": "1" } ] },
  { "id": "animatePulse", "category": "animation", "shape": "stack", "color": "#9C27B0",
    "label": "animate pulse", "code": "animation: pulse %ns;",
    "inputs": [ { "id": "duration", "type": "number", "default": "1" } ] },
  { "id": "animateRotate", "category": "animation", "shape": "stack", "color": "#9C27B0",
    "label": "animate rotate", "code": "animation: rotate %ns;",
    "inputs": [ { "id": "duration", "type": "number", "default": "1" } ] },
  { "id": "animateShake", "category": "animation", "shape": "stack", "color": "#9C27B0",
    "label": "animate shake", "code": "animation: shake %ns;",
    "inputs": [ { "id": "duration", "type": "number", "default": "1" } ] },
  { "id": "transitionAll", "category": "animation", "shape": "stack", "color": "#9C27B0",
    "label": "transition all", "code": "transition: all %ns;",
    "inputs": [ { "id": "duration", "type": "number", "default": "0.3" } ] },
  { "id": "transitionColor", "category": "animation", "shape": "stack", "color": "#9C27B0",
    "label": "transition color", "code": "transition: color %ns;",
    "inputs": [ { "id": "duration", "type": "number", "default": "0.3" } ] },
  { "id": "transitionTransform", "category": "animation", "shape": "stack", "color": "#9C27B0",
    "label": "transition transform", "code": "transition: transform %ns;",
    "inputs": [ { "id": "duration", "type": "number", "default": "0.3" } ] },
  { "id": "animateSlideUp", "category": "animation", "shape": "stack", "color": "#9C27B0",
    "label": "slide-up %ns", "code": "animation: slideUp %ns ease both;",
    "inputs": [ { "id": "duration", "type": "number", "default": "0.6" } ] },
  { "id": "animateSlideDown", "category": "animation", "shape": "stack", "color": "#9C27B0",
    "label": "slide-down %ns", "code": "animation: slideDown %ns ease both;",
    "inputs": [ { "id": "duration", "type": "number", "default": "0.6" } ] },
  { "id": "animateSlideLeft", "category": "animation", "shape": "stack", "color": "#9C27B0",
    "label": "slide-left %ns", "code": "animation: slideLeft %ns ease both;",
    "inputs": [ { "id": "duration", "type": "number", "default": "0.6" } ] },
  { "id": "animateSlideRight", "category": "animation", "shape": "stack", "color": "#9C27B0",
    "label": "slide-right %ns", "code": "animation: slideRight %ns ease both;",
    "inputs": [ { "id": "duration", "type": "number", "default": "0.6" } ] },
  { "id": "animateZoomIn", "category": "animation", "shape": "stack", "color": "#9C27B0",
    "label": "zoom-in %ns", "code": "animation: zoomIn %ns ease both;",
    "inputs": [ { "id": "duration", "type": "number", "default": "0.4" } ] },
  { "id": "animateZoomOut", "category": "animation", "shape": "stack", "color": "#9C27B0",
    "label": "zoom-out %ns", "code": "animation: zoomOut %ns ease both;",
    "inputs": [ { "id": "duration", "type": "number", "default": "0.4" } ] },
  { "id": "animateFlip", "category": "animation", "shape": "stack", "color": "#9C27B0",
    "label": "flip %ns", "code": "animation: flip %ns ease both;",
    "inputs": [ { "id": "duration", "type": "number", "default": "0.8" } ] },
  { "id": "animateCustom", "category": "animation", "shape": "stack", "color": "#9C27B0",
    "label": "%s %ns %s %s %m.iter %m.fill",
    "code": "animation: %s %ns %s %s %s %s;",
    "inputs": [
      { "id": "name",     "type": "dropdown", "default": "fadeIn",
        "options": ["fadeIn","fadeOut","slideIn","slideOut","slideUp","slideDown","slideLeft","slideRight","zoomIn","zoomOut","bounce","pulse","rotate","shake","flip"] },
      { "id": "duration", "type": "number", "default": "0.6" },
      { "id": "easing",   "type": "dropdown", "default": "ease",
        "options": ["linear","ease","ease-in","ease-out","ease-in-out","spring","bounce-out"] },
      { "id": "delay",    "type": "text",   "default": "0s" },
      { "id": "iter",     "type": "dropdown", "default": "1",
        "options": ["1","2","3","infinite"] },
      { "id": "fill",     "type": "dropdown", "default": "both",
        "options": ["none","forwards","backwards","both"] }
    ] },
  { "id": "transitionCustom", "category": "animation", "shape": "stack", "color": "#9C27B0",
    "label": "transition %s %ns %s %s",
    "code": "transition: %s %ns %s %s;",
    "inputs": [
      { "id": "property", "type": "text",     "default": "all" },
      { "id": "duration", "type": "number",   "default": "0.3" },
      { "id": "easing",   "type": "dropdown", "default": "ease",
        "options": ["linear","ease","ease-in","ease-out","ease-in-out","spring","bounce-out"] },
      { "id": "delay",    "type": "text",     "default": "0s" }
    ] },
  { "id": "hoverScale", "category": "animation", "shape": "stack", "color": "#9C27B0",
    "label": "hover scale %n", "code": "transition: transform 0.2s ease; transform: scale(1);",
    "inputs": [ { "id": "scale", "type": "number", "default": "1.05" } ] },
  { "id": "scrollReveal", "category": "animation", "shape": "stack", "color": "#9C27B0",
    "label": "scroll reveal %s", "code": "animation: %s 0.6s ease both; animation-timeline: view();",
    "inputs": [ { "id": "name", "type": "dropdown", "default": "fadeIn",
        "options": ["fadeIn","slideUp","slideDown","slideLeft","slideRight","zoomIn"] } ] },

  { "id": "valueString", "category": "value", "shape": "value", "color": "#7E57C2",
    "label": "%s", "code": "%s",
    "inputs": [ { "id": "value", "type": "text", "default": "" } ] },
  { "id": "valueNumber", "category": "value", "shape": "reporter", "color": "#7E57C2",
    "label": "%n %m.unit", "code": "%n%m.unit",
    "inputs": [
      { "id": "value", "type": "number", "default": "0" },
      { "id": "unit", "type": "dropdown", "default": "px", "options": ["px","%","rem","em","vw","vh","s","ms",""] }
    ] },
  { "id": "valueBoolean", "category": "value", "shape": "boolean", "color": "#7E57C2",
    "label": "%b", "code": "%b",
    "inputs": [ { "id": "value", "type": "boolean", "default": "false" } ] },
  { "id": "valueColor", "category": "value", "shape": "value", "color": "#7E57C2",
    "label": "%m.color", "code": "%m.color",
    "inputs": [ { "id": "value", "type": "color", "default": "#000000" } ] },
  { "id": "stringConcat", "category": "value", "shape": "value", "color": "#7E57C2",
    "label": "%s + %s", "code": "%s %s",
    "inputs": [
      { "id": "a", "type": "text", "default": "" },
      { "id": "b", "type": "text", "default": "" }
    ] },

  { "id": "ifBlock", "category": "logic", "shape": "condition", "color": "#E91E63",
    "label": "if %s {", "code": "if (%s) { %m.space }",
    "inputs": [ { "id": "condition", "type": "text", "default": "true" } ] },
  { "id": "loop", "category": "logic", "shape": "loop", "color": "#E91E63",
    "label": "repeat %n {", "code": "for (var i = 0; i < %n; i++) { %m.space }",
    "inputs": [ { "id": "count", "type": "number", "default": "10" } ] },

  { "id": "asdHtml", "category": "asd", "shape": "stack", "color": "#455A64",
