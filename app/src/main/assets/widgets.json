        "border": "1px solid #E2E8F0"
      },
      "script": "function submitForm(formId) {\n  const form = document.getElementById(formId);\n  if (!form) return;\n  form.dispatchEvent(new Event('submit', { cancelable: true }));\n}\nfunction resetForm(formId) {\n  const form = document.getElementById(formId);\n  if (form) form.reset();\n}\nfunction getFormFieldValue(formId, fieldName) {\n  const form = document.getElementById(formId);\n  if (!form || !form.elements[fieldName]) return '';\n  return form.elements[fieldName].value;\n}\nfunction setFormFieldValue(formId, fieldName, val) {\n  const form = document.getElementById(formId);\n  if (form && form.elements[fieldName]) {\n    form.elements[fieldName].value = val;\n  }\n}",
      "customProperties": {
