  {
    "name": "Carousel",
    "tag": "div",
    "icon": "photo",
    "category": "media",
    "function": {
      "slides": [
        "https://via.placeholder.com/600x300?text=Slide+1",
        "https://via.placeholder.com/600x300?text=Slide+2",
        "https://via.placeholder.com/600x300?text=Slide+3"
      ],
      "style": {
        "width": "100%",
        "height": "240px",
        "backgroundColor": "#0F172A",
        "borderRadius": "14px",
        "overflow": "hidden",
        "position": "relative",
        "display": "flex",
        "alignItems": "center",
        "justifyContent": "center"
      },
      "script": "function carouselNext(cId) {\n  const c = document.getElementById(cId);\n  if (!c) return;\n  const slides = c.querySelectorAll('.carousel-slide');\n  let cur = Array.from(slides).findIndex(s => s.classList.contains('active'));\n  if (cur >= 0) {\n    slides[cur].classList.remove('active');\n    slides[(cur + 1) % slides.length].classList.add('active');\n  }\n}\nfunction carouselPrev(cId) {\n  const c = document.getElementById(cId);\n  if (!c) return;\n  const slides = c.querySelectorAll('.carousel-slide');\n  let cur = Array.from(slides).findIndex(s => s.classList.contains('active'));\n  if (cur >= 0) {\n    slides[cur].classList.remove('active');\n    slides[(cur - 1 + slides.length) % slides.length].classList.add('active');\n  }\n}",
