        "boxShadow": "0 2px 10px rgba(0, 0, 0, 0.05)"
      },
      "script": "function filterTable(tableId, query) {\n  const table = document.getElementById(tableId);\n  if (!table) return;\n  const rows = table.querySelectorAll('tbody tr');\n  rows.forEach(row => {\n    row.style.display = row.innerText.toLowerCase().includes(query.toLowerCase()) ? '' : 'none';\n  });\n}\nfunction sortTable(tableId, colIndex) {\n  const table = document.getElementById(tableId);\n  if (!table) return;\n  const tbody = table.querySelector('tbody') || table;\n  const rows = Array.from(tbody.querySelectorAll('tr'));\n  rows.sort((a, b) => a.cells[colIndex].innerText.localeCompare(b.cells[colIndex].innerText));\n  rows.forEach(r => tbody.appendChild(r));\n}",
      "customProperties": {
        "headers": {
          "type": "setupList",
          "dialog": "dialog_setup_list"
        }
      }
    }
  },
  {
    "name": "Progress Bar",
    "tag": "div",
    "icon": "box",
    "category": "advanced",
    "function": {
      "value": "70",
      "max": "100",
      "style": {
        "width": "100%",
        "height": "14px",
        "backgroundColor": "#E2E8F0",
        "borderRadius": "10px",
        "overflow": "hidden",
        "position": "relative",
        "margin": "10px 0"
      },
      "script": "function setProgress(barId, percent) {\n  const el = barId && (barId.startsWith('#') || barId.startsWith('.')) ? document.querySelector(barId) : (document.getElementById(barId) || document.querySelector(barId));\n  if (!el) return;\n  const fill = el.querySelector('.progress-fill') || el;\n  fill.style.width = Math.min(100, Math.max(0, percent)) + '%';\n}\nfunction incrementProgress(barId, amount) {\n  const el = barId && (barId.startsWith('#') || barId.startsWith('.')) ? document.querySelector(barId) : (document.getElementById(barId) || document.querySelector(barId));\n  if (!el) return;\n  const fill = el.querySelector('.progress-fill') || el;\n  const current = parseFloat(fill.style.width) || 0;\n  setProgress(barId, current + amount);\n}",
      "customProperties": {
        "value": {
          "type": "number",
          "default": 70
        },
        "max": {
          "type": "number",
          "default": 100
        }
      }
    }
  },
