<androidx.drawerlayout.widget.DrawerLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/_main"
	android:layout_width="match_parent"
	android:layout_height="match_parent">

	<!-- Main Content Area -->
	<LinearLayout
		android:id="@+id/main"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:orientation="vertical">

		<!-- Top Bar -->
		<LinearLayout
			android:id="@+id/topBar"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="4dp"
			android:gravity="center_vertical"
			android:orientation="horizontal"
			android:background="?attr/colorSurfaceContainerHigh">
			<Button
				android:id="@+id/btnDrawer"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				style="?attr/materialIconButtonStyle"
				app:icon="@drawable/icon_widgets_round" />
			<Button
				android:id="@+id/btnBack"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Back"
				android:textSize="11sp"
				style="?attr/materialIconButtonStyle" />
			<TextView
				android:id="@+id/tvProjectTitle"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:text="DragWeb"
				android:textSize="16sp"
				android:textStyle="bold"
				android:textColor="?attr/colorOnSurface"
				android:singleLine="true"
				android:ellipsize="end"
				android:paddingLeft="4dp" />
			<Button
				android:id="@+id/button4"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:textSize="12sp"
				android:textColor="#000000"
				style="?attr/materialIconButtonFilledStyle"
				app:icon="@drawable/icon_save_round" />
			<Button
				android:id="@+id/btnUndo"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:enabled="false"
				style="?attr/materialIconButtonStyle"
				app:icon="@drawable/icon_undo_round" />
			<Button
				android:id="@+id/btnRedo"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:enabled="false"
				style="?attr/materialIconButtonStyle"
				app:icon="@drawable/icon_redo_round" />
			<Button
				android:id="@+id/btnTheme"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				style="?attr/materialIconButtonStyle"
				app:icon="@drawable/icon_theme_round" />
		</LinearLayout>

		<!-- Horizontal Middle Area (Canvas + Right Panel) -->
		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="0dp"
			android:layout_weight="1"
			android:orientation="horizontal">

			<!-- Center pane: Design Canvas -->
			<LinearLayout
				android:layout_width="0dp"
				android:layout_height="match_parent"
				android:layout_weight="1"
				android:padding="4dp"
				android:orientation="vertical">
				<LinearLayout
					android:id="@+id/scre"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:gravity="center"
					android:orientation="vertical">
					<androidx.core.widget.NestedScrollView
						android:id="@+id/vscroll2"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content">
						<LinearLayout
							android:id="@+id/screen"
							android:layout_width="320dp"
							android:layout_height="540dp"
							android:padding="4dp"
							android:gravity="center_horizontal|top"
							android:orientation="vertical"
							android:background="?attr/colorSurface"
							android:elevation="4dp"
							android:minHeight="540dp" />
					</androidx.core.widget.NestedScrollView>
				</LinearLayout>
			</LinearLayout>

			<!-- Right side panel -->
			<androidx.recyclerview.widget.RecyclerView
				android:id="@+id/recyclerviewRightPanel"
				android:layout_width="120dp"
				android:layout_height="match_parent"
				android:padding="4dp"
				android:background="?attr/colorSurfaceContainer"
				android:clipToPadding="false"
				android:visibility="gone" /> <!-- Currently invisible, ready for future properties if needed, or used later -->
		</LinearLayout>

		<!-- Bottom Panel -->
		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:background="?attr/colorSurfaceContainerHigh"
			android:padding="8dp">

			<!-- Top row: Styles horizontal list -->
			<androidx.recyclerview.widget.RecyclerView
				android:id="@+id/recyclerview3"
				android:layout_width="match_parent"
				android:layout_height="50dp"
				android:orientation="horizontal"
				tools:listitem="@layout/design" />

			<!-- Bottom row: Selected widget & actions -->
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="horizontal"
				android:gravity="center_vertical"
				android:layout_marginTop="8dp">

				<Spinner
					android:id="@+id/widgetSpinner"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:minHeight="48dp" />

				<TextView
					android:id="@+id/textview2"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="No selection"
					android:textSize="12sp"
					android:visibility="gone" />

				<Button
					android:id="@+id/delete"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:textSize="12sp"
					android:textColor="#000000"
					android:enabled="false"
					style="?attr/materialIconButtonFilledStyle"
					app:icon="@drawable/icon_delete_round" />

				<Button
					android:id="@+id/button5"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:textSize="12sp"
					android:textColor="#000000"
					style="?attr/materialIconButtonFilledStyle"
					app:icon="@drawable/icon_web_round" />

				<Button
					android:id="@+id/btnExport"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:textSize="12sp"
					style="?attr/materialIconButtonFilledStyle"
					app:icon="@drawable/icon_export_round" />
			</LinearLayout>
		</LinearLayout>
	</LinearLayout>

	<!-- Left Drawer: Widget Palette -->
	<LinearLayout
		android:layout_width="280dp"
		android:layout_height="match_parent"
		android:layout_gravity="start"
		android:background="?attr/colorSurface"
		android:padding="8dp"
		android:orientation="vertical">
		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="Widgets"
			android:textSize="18sp"
			android:textStyle="bold"
			android:paddingBottom="8dp" />
		<Button
			android:id="@+id/btnImportWidgets"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="Import JSON"
			android:textSize="12sp"
			style="?attr/materialButtonOutlinedStyle" />
		<Button
			android:id="@+id/btnImportImage"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="Import Image"
			android:textSize="12sp"
			style="?attr/materialButtonOutlinedStyle" />
		<androidx.recyclerview.widget.RecyclerView
			android:id="@+id/recyclerview1"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			tools:listitem="@layout/widgets" />
	</LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
