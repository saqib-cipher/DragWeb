<androidx.drawerlayout.widget.DrawerLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/_main"
	android:layout_width="match_parent"
	android:layout_height="match_parent">

	<!-- Main Content Area -->
	<LinearLayout
		android:id="@+id/main"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:orientation="vertical"
		android:background="?attr/colorSurface">

		<!-- Top Bar -->
		<LinearLayout
			android:id="@+id/topBar"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="2dp"
			android:gravity="center_vertical"
			android:orientation="horizontal"
			android:background="?attr/colorSurfaceContainerHigh">
			<Button
				android:id="@+id/btnDrawer"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				style="?attr/materialIconButtonStyle"
				app:icon="@drawable/icon_widgets_round" />
			<Button
				android:id="@+id/btnBack"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="&#8249;"
				android:textSize="18sp"
				style="?attr/materialIconButtonStyle" />
			<TextView
				android:id="@+id/tvProjectTitle"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:text="DragWeb"
				android:textSize="14sp"
				android:textStyle="bold"
				android:textColor="?attr/colorOnSurface"
				android:singleLine="true"
				android:ellipsize="end"
				android:paddingLeft="4dp" />
			<Button
				android:id="@+id/button4"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				style="?attr/materialIconButtonFilledStyle"
				app:icon="@drawable/icon_save_round" />
			<Button
				android:id="@+id/btnUndo"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:enabled="false"
				style="?attr/materialIconButtonStyle"
				app:icon="@drawable/icon_undo_round" />
			<Button
				android:id="@+id/btnRedo"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:enabled="false"
				style="?attr/materialIconButtonStyle"
				app:icon="@drawable/icon_redo_round" />
			<Button
				android:id="@+id/btnTheme"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				style="?attr/materialIconButtonStyle"
				app:icon="@drawable/icon_theme_round" />
		</LinearLayout>

		<!-- Tab Bar: View / Event / Assets -->
		<com.google.android.material.tabs.TabLayout
			android:id="@+id/tabLayout"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			app:tabMode="fixed"
			app:tabGravity="fill"
			app:tabIndicatorColor="?attr/colorPrimary"
			app:tabSelectedTextColor="?attr/colorPrimary"
			app:tabTextColor="?attr/colorOnSurfaceVariant"
			android:background="?attr/colorSurfaceContainerHigh">
			<com.google.android.material.tabs.TabItem
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="View" />
			<com.google.android.material.tabs.TabItem
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Event" />
			<com.google.android.material.tabs.TabItem
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Assets" />
		</com.google.android.material.tabs.TabLayout>

		<!-- Main Area: Canvas + Hierarchy Panel side by side -->
		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="0dp"
			android:layout_weight="1"
			android:orientation="horizontal">

			<!-- Center pane: Design Canvas -->
			<LinearLayout
				android:layout_width="0dp"
				android:layout_height="match_parent"
				android:layout_weight="1"
				android:padding="4dp"
				android:orientation="vertical">
				<FrameLayout
					android:layout_width="match_parent"
					android:layout_height="match_parent">

					<!-- Canvas area (View tab) -->
					<androidx.core.widget.NestedScrollView
						android:id="@+id/vscroll2"
						android:layout_width="match_parent"
						android:layout_height="match_parent">
						<LinearLayout
							android:id="@+id/screen"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:padding="4dp"
							android:gravity="center_horizontal|top"
							android:orientation="vertical"
							android:background="?attr/colorSurface"
							android:elevation="2dp"
							android:minHeight="540dp" />
					</androidx.core.widget.NestedScrollView>

					<!-- Event panel (hidden by default) -->
					<LinearLayout
						android:id="@+id/eventPanel"
						android:layout_width="match_parent"
						android:layout_height="match_parent"
						android:orientation="vertical"
						android:padding="16dp"
						android:visibility="gone"
						android:background="?attr/colorSurface">

						<TextView
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:text="Logic Blocks"
							android:textSize="16sp"
							android:textStyle="bold"
							android:textColor="?attr/colorOnSurface"
							android:paddingBottom="8dp" />
						<TextView
							android:id="@+id/tvEventHint"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:text="Select a widget and add events.\nEvents: click, hover, input, load\nActions: change style, animate, navigate, show/hide, set text, add class, run JS"
							android:textSize="13sp"
							android:textColor="?attr/colorOnSurfaceVariant"
							android:paddingBottom="12dp" />

						<ScrollView
							android:layout_width="match_parent"
							android:layout_height="0dp"
							android:layout_weight="1"
							android:layout_marginBottom="8dp">
							<LinearLayout
								android:id="@+id/blockContainer"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:orientation="vertical" />
						</ScrollView>

						<Button
							android:id="@+id/btnAddLogicBlock"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:text="+ Add Logic Block"
							style="?attr/materialButtonOutlinedStyle" />
						<Button
							android:id="@+id/btnViewAllBlocks"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:text="View All Blocks"
							android:layout_marginTop="8dp"
							style="?attr/materialButtonOutlinedStyle" />
					</LinearLayout>

					<!-- Assets panel (hidden by default) -->
					<LinearLayout
						android:id="@+id/assetsPanel"
						android:layout_width="match_parent"
						android:layout_height="match_parent"
						android:orientation="vertical"
						android:padding="16dp"
						android:visibility="gone"
						android:background="?attr/colorSurface">

						<TextView
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:text="Assets Manager"
							android:textSize="16sp"
							android:textStyle="bold"
							android:textColor="?attr/colorOnSurface"
							android:paddingBottom="8dp" />

						<TextView
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:text="Import and manage images, icons, and files for your project."
							android:textSize="13sp"
							android:textColor="?attr/colorOnSurfaceVariant"
							android:paddingBottom="12dp" />

						<Button
							android:id="@+id/btnImportImage"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:text="Import Image from Device"
							android:textSize="13sp"
							style="?attr/materialButtonOutlinedStyle" />

						<Button
							android:id="@+id/btnImportWidgets"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:text="Import JSON Widgets"
							android:textSize="13sp"
							android:layout_marginTop="8dp"
							style="?attr/materialButtonOutlinedStyle" />

						<Button
							android:id="@+id/btnImportSvg"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:text="Import Custom SVG"
							android:textSize="13sp"
							android:layout_marginTop="8dp"
							style="?attr/materialButtonOutlinedStyle" />

						<Button
							android:id="@+id/btnNewFolder"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:text="New Folder"
							android:textSize="13sp"
							android:layout_marginTop="8dp"
							style="?attr/materialButtonOutlinedStyle" />

						<View
							android:layout_width="match_parent"
							android:layout_height="1dp"
							android:background="?attr/colorOutlineVariant"
							android:layout_marginTop="12dp"
							android:layout_marginBottom="8dp" />

						<TextView
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:text="Icon Libraries"
							android:textSize="14sp"
							android:textStyle="bold"
							android:textColor="?attr/colorOnSurface"
							android:paddingBottom="8dp" />

						<!-- Search for icon libraries -->
						<com.google.android.material.textfield.TextInputLayout
							android:id="@+id/searchIconLibLayout"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:hint="Search icons..."
							app:boxCornerRadiusTopStart="8dp"
							app:boxCornerRadiusTopEnd="8dp"
							app:boxCornerRadiusBottomStart="8dp"
							app:boxCornerRadiusBottomEnd="8dp"
							style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense">
							<com.google.android.material.textfield.TextInputEditText
								android:id="@+id/etSearchIconLib"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:textSize="12sp"
								android:inputType="text"
								android:maxLines="1" />
						</com.google.android.material.textfield.TextInputLayout>

						<com.google.android.material.chip.ChipGroup
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginTop="8dp">
							<com.google.android.material.chip.Chip
								android:id="@+id/chipFontAwesome"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="Font Awesome"
								android:textSize="11sp"
								style="@style/Widget.Material3.Chip.Assist" />
							<com.google.android.material.chip.Chip
								android:id="@+id/chipTablerIcons"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="Tabler Icons"
								android:textSize="11sp"
								style="@style/Widget.Material3.Chip.Assist" />
							<com.google.android.material.chip.Chip
								android:id="@+id/chipBootstrapIcons"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="Bootstrap Icons"
								android:textSize="11sp"
								style="@style/Widget.Material3.Chip.Assist" />
							<com.google.android.material.chip.Chip
								android:id="@+id/chipCustomSvg"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="Custom SVG"
								android:textSize="11sp"
								style="@style/Widget.Material3.Chip.Assist" />
						</com.google.android.material.chip.ChipGroup>

						<!-- Imported assets list -->
						<TextView
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:text="Project Files"
							android:textSize="14sp"
							android:textStyle="bold"
							android:textColor="?attr/colorOnSurface"
							android:paddingTop="12dp"
							android:paddingBottom="4dp" />

						<androidx.recyclerview.widget.RecyclerView
							android:id="@+id/rvAssets"
							android:layout_width="match_parent"
							android:layout_height="0dp"
							android:layout_weight="1"
							android:layout_marginTop="4dp"
							android:clipToPadding="false" />
					</LinearLayout>
				</FrameLayout>
			</LinearLayout>

			<!-- Right side panel: Hierarchy Tree -->
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/rightPanelCard"
				android:layout_width="160dp"
				android:layout_height="match_parent"
				android:layout_margin="4dp"
				app:cardCornerRadius="12dp"
				app:cardElevation="2dp"
				app:cardBackgroundColor="?attr/colorSurfaceContainer">
				<LinearLayout
					android:id="@+id/rightPanel"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:orientation="vertical"
					android:padding="6dp">
					<TextView
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:text="Hierarchy"
						android:textSize="13sp"
						android:textStyle="bold"
						android:textColor="?attr/colorOnSurface"
						android:gravity="center"
						android:paddingTop="2dp"
						android:paddingBottom="4dp" />

					<!-- Widget search in hierarchy -->
					<com.google.android.material.textfield.TextInputLayout
						android:id="@+id/searchHierarchyLayout"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:hint="Find..."
						app:boxCornerRadiusTopStart="8dp"
						app:boxCornerRadiusTopEnd="8dp"
						app:boxCornerRadiusBottomStart="8dp"
						app:boxCornerRadiusBottomEnd="8dp"
						style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense">
						<com.google.android.material.textfield.TextInputEditText
							android:id="@+id/etSearchHierarchy"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:textSize="11sp"
							android:inputType="text"
							android:maxLines="1" />
					</com.google.android.material.textfield.TextInputLayout>

					<androidx.recyclerview.widget.RecyclerView
						android:id="@+id/recyclerviewRightPanel"
						android:layout_width="match_parent"
						android:layout_height="0dp"
						android:layout_weight="1"
						android:layout_marginTop="4dp"
						android:clipToPadding="false" />
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
		</LinearLayout>

		<!-- Bottom Panel: Style Management -->
		<LinearLayout
			android:id="@+id/bottomPanel"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:background="?attr/colorSurfaceContainerHigh"
			android:padding="6dp">

			<!-- Style items horizontal list -->
			<HorizontalScrollView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:scrollbars="none">
				<LinearLayout
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:orientation="horizontal">
					<androidx.recyclerview.widget.RecyclerView
						android:id="@+id/recyclerview3"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:orientation="horizontal"
						tools:listitem="@layout/design" />
				</LinearLayout>
			</HorizontalScrollView>

			<!-- Tabs: Basic / Styles / Layout / Event -->
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="horizontal"
				android:layout_marginTop="4dp"
				android:layout_marginBottom="4dp">
				<com.google.android.material.chip.Chip
					android:id="@+id/chipBasic"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Basic"
					android:textSize="11sp"
					style="@style/Widget.Material3.Chip.Filter"
					android:checked="true" />
				<com.google.android.material.chip.Chip
					android:id="@+id/chipStyles"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Styles"
					android:textSize="11sp"
					style="@style/Widget.Material3.Chip.Filter" />
				<com.google.android.material.chip.Chip
					android:id="@+id/chipLayout"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Layout"
					android:textSize="11sp"
					style="@style/Widget.Material3.Chip.Filter" />
				<com.google.android.material.chip.Chip
					android:id="@+id/chipEvent"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Event"
					android:textSize="11sp"
					style="@style/Widget.Material3.Chip.Filter" />
			</LinearLayout>

			<!-- Bottom row: Selected widget & actions -->
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="horizontal"
				android:gravity="center_vertical">

				<Spinner
					android:id="@+id/widgetSpinner"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:minHeight="40dp" />

				<TextView
					android:id="@+id/textview2"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="No selection"
					android:textSize="11sp"
					android:visibility="gone" />

				<Button
					android:id="@+id/delete"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:enabled="false"
					style="?attr/materialIconButtonFilledStyle"
					app:icon="@drawable/icon_delete_round" />

				<Button
					android:id="@+id/button5"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					style="?attr/materialIconButtonFilledStyle"
					app:icon="@drawable/icon_web_round" />

				<Button
					android:id="@+id/btnExport"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					style="?attr/materialIconButtonFilledStyle"
					app:icon="@drawable/icon_export_round" />

				<Button
					android:id="@+id/btnViewStyles"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					style="?attr/materialIconButtonStyle"
					app:icon="@drawable/icon_design_services_round" />
			</LinearLayout>
		</LinearLayout>
	</LinearLayout>

	<!-- Left Drawer: Widgets Palette + Settings -->
	<LinearLayout
		android:layout_width="300dp"
		android:layout_height="match_parent"
		android:layout_gravity="start"
		android:background="?attr/colorSurface"
		android:orientation="vertical">

		<!-- Drawer header -->
		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal"
			android:padding="12dp"
			android:gravity="center_vertical"
			android:background="?attr/colorSurfaceContainerHigh">
			<ImageView
				android:layout_width="24dp"
				android:layout_height="24dp"
				android:src="@drawable/icon_widgets_round"
				app:tint="?attr/colorPrimary" />
			<TextView
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:text="Widget Palette"
				android:textSize="16sp"
				android:textStyle="bold"
				android:textColor="?attr/colorOnSurface"
				android:paddingLeft="8dp" />
		</LinearLayout>

		<!-- Search bar for widgets -->
		<com.google.android.material.textfield.TextInputLayout
			android:id="@+id/searchWidgetLayout"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginStart="8dp"
			android:layout_marginEnd="8dp"
			android:layout_marginTop="8dp"
			android:hint="Search widgets..."
			app:boxCornerRadiusTopStart="8dp"
			app:boxCornerRadiusTopEnd="8dp"
			app:boxCornerRadiusBottomStart="8dp"
			app:boxCornerRadiusBottomEnd="8dp"
			style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense">
			<com.google.android.material.textfield.TextInputEditText
				android:id="@+id/etSearchWidget"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:textSize="12sp"
				android:inputType="text"
				android:maxLines="1" />
		</com.google.android.material.textfield.TextInputLayout>

		<!-- Widget category chips -->
		<HorizontalScrollView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:scrollbars="none"
			android:layout_marginTop="4dp"
			android:paddingLeft="8dp"
			android:paddingRight="8dp">
			<com.google.android.material.chip.ChipGroup
				android:id="@+id/chipGroupCategories"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				app:singleSelection="true"
				app:singleLine="true">
				<com.google.android.material.chip.Chip
					android:id="@+id/chipCatAll"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="All"
					android:textSize="10sp"
					android:checked="true"
					style="@style/Widget.Material3.Chip.Filter" />
				<com.google.android.material.chip.Chip
					android:id="@+id/chipCatLayout"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Layout"
					android:textSize="10sp"
					style="@style/Widget.Material3.Chip.Filter" />
				<com.google.android.material.chip.Chip
					android:id="@+id/chipCatBasic"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Basic"
					android:textSize="10sp"
					style="@style/Widget.Material3.Chip.Filter" />
				<com.google.android.material.chip.Chip
					android:id="@+id/chipCatForm"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Form"
					android:textSize="10sp"
					style="@style/Widget.Material3.Chip.Filter" />
				<com.google.android.material.chip.Chip
					android:id="@+id/chipCatMedia"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Media"
					android:textSize="10sp"
					style="@style/Widget.Material3.Chip.Filter" />
				<com.google.android.material.chip.Chip
					android:id="@+id/chipCatAdvanced"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Advanced"
					android:textSize="10sp"
					style="@style/Widget.Material3.Chip.Filter" />
			</com.google.android.material.chip.ChipGroup>
		</HorizontalScrollView>

		<!-- Widget RecyclerView -->
		<androidx.recyclerview.widget.RecyclerView
			android:id="@+id/recyclerview1"
			android:layout_width="match_parent"
			android:layout_height="0dp"
			android:layout_weight="1"
			android:layout_marginTop="4dp"
			android:paddingLeft="8dp"
			android:paddingRight="8dp"
			android:clipToPadding="false"
			tools:listitem="@layout/widgets" />

		<!-- Drawer bottom: Custom configs -->
		<View
			android:layout_width="match_parent"
			android:layout_height="1dp"
			android:background="?attr/colorOutlineVariant" />

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:padding="8dp">

			<Button
				android:id="@+id/btnLoadCustomWidgets"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="Load Custom Widgets JSON"
				android:textSize="11sp"
				style="?attr/materialButtonOutlinedStyle" />

			<Button
				android:id="@+id/btnLoadCustomBlocks"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="Load Custom Blocks JSON"
				android:textSize="11sp"
				android:layout_marginTop="4dp"
				style="?attr/materialButtonOutlinedStyle" />
		</LinearLayout>
