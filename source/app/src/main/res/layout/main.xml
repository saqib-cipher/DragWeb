<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical"
	android:id="@+id/_main">
	<LinearLayout
		android:id="@+id/main"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:orientation="vertical">
		<LinearLayout
			android:id="@+id/topBar"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="4dp"
			android:gravity="center_vertical"
			android:orientation="horizontal"
			android:background="?attr/colorSurfaceContainerHigh">
			<Button
				android:id="@+id/btnBack"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Back"
				android:textSize="11sp"
				style="?attr/materialIconButtonStyle" />
			<TextView
				android:id="@+id/tvProjectTitle"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:text="DragWeb"
				android:textSize="16sp"
				android:textStyle="bold"
				android:textColor="?attr/colorOnSurface"
				android:singleLine="true"
				android:ellipsize="end"
				android:paddingLeft="4dp" />
			<Button
				android:id="@+id/btnUndo"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:enabled="false"
				style="?attr/materialIconButtonStyle"
				app:icon="@drawable/icon_undo_round" />
			<Button
				android:id="@+id/btnRedo"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:enabled="false"
				style="?attr/materialIconButtonStyle"
				app:icon="@drawable/icon_redo_round" />
			<Button
				android:id="@+id/btnTheme"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				style="?attr/materialIconButtonStyle"
				app:icon="@drawable/icon_theme_round" />
		</LinearLayout>
		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:orientation="horizontal">
			<!-- Left pane: Widget Palette -->
			<LinearLayout
				android:layout_width="0dp"
				android:layout_height="match_parent"
				android:layout_weight="1"
				android:padding="4dp"
				android:orientation="vertical">
				<Button
					android:id="@+id/btnImportWidgets"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:text="Import JSON"
					android:textSize="12sp"
					style="?attr/materialButtonOutlinedStyle" />
				<androidx.recyclerview.widget.RecyclerView
					android:id="@+id/recyclerview1"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					tools:listitem="@layout/widgets" />
			</LinearLayout>

			<!-- Center pane: Design Canvas -->
			<LinearLayout
				android:layout_width="0dp"
				android:layout_height="match_parent"
				android:layout_weight="2"
				android:padding="4dp"
				android:orientation="vertical">
				<LinearLayout
					android:id="@+id/linear9"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center"
					android:orientation="horizontal">
					<Button
						android:id="@+id/button5"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:textSize="12sp"
						android:textColor="#000000"
						style="?attr/materialIconButtonFilledStyle"
						app:icon="@drawable/icon_web_round" />
					<Button
						android:id="@+id/button4"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:textSize="12sp"
						android:textColor="#000000"
						style="?attr/materialIconButtonFilledStyle"
						app:icon="@drawable/icon_save_round" />
					<Button
						android:id="@+id/btnExport"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:textSize="12sp"
						style="?attr/materialIconButtonFilledStyle"
						app:icon="@drawable/icon_export_round" />
				</LinearLayout>
				<LinearLayout
					android:id="@+id/scre"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:gravity="center"
					android:orientation="vertical">
					<androidx.core.widget.NestedScrollView
						android:id="@+id/vscroll2"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content">
						<LinearLayout
							android:id="@+id/screen"
							android:layout_width="240dp"
							android:layout_height="420dp"
							android:padding="4dp"
							android:gravity="center_horizontal|top"
							android:orientation="vertical"
							android:background="?attr/colorSurface"
							android:elevation="4dp"
							android:minHeight="420dp" />
					</androidx.core.widget.NestedScrollView>
				</LinearLayout>
			</LinearLayout>

			<!-- Right pane: Property Editor -->
			<LinearLayout
				android:layout_width="0dp"
				android:layout_height="match_parent"
				android:layout_weight="1"
				android:padding="4dp"
				android:orientation="vertical">
				<LinearLayout
					android:id="@+id/linear10"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center_vertical"
					android:orientation="horizontal">
					<TextView
						android:id="@+id/textview2"
						android:layout_width="0dp"
						android:layout_weight="1"
						android:layout_height="wrap_content"
						android:padding="8dp"
						android:text="No widget selected"
						android:textSize="12sp"
						android:textColor="?attr/colorOnSurfaceVariant" />
					<Button
						android:id="@+id/delete"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:textSize="12sp"
						android:textColor="#000000"
						android:enabled="false"
						style="?attr/materialIconButtonFilledStyle"
						app:icon="@drawable/icon_delete_round" />
				</LinearLayout>
				<androidx.recyclerview.widget.RecyclerView
					android:id="@+id/recyclerview3"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					tools:listitem="@layout/design" />
			</LinearLayout>
		</LinearLayout>
	</LinearLayout>
</LinearLayout>
