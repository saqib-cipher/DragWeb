<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical"
	android:id="@+id/_main">
	<LinearLayout
		android:id="@+id/main"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:orientation="vertical">
		<LinearLayout
			android:id="@+id/topBar"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="4dp"
			android:gravity="center_vertical"
			android:orientation="horizontal"
			android:background="?attr/colorSurfaceContainerHigh">
			<Button
				android:id="@+id/btnBack"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Back"
				android:textSize="11sp"
				style="?attr/materialIconButtonStyle" />
			<TextView
				android:id="@+id/tvProjectTitle"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:text="DragWeb"
				android:textSize="16sp"
				android:textStyle="bold"
				android:textColor="?attr/colorOnSurface"
				android:singleLine="true"
				android:ellipsize="end"
				android:paddingLeft="4dp" />
			<Button
				android:id="@+id/btnUndo"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:enabled="false"
				style="?attr/materialIconButtonStyle"
				app:icon="@drawable/icon_undo_round" />
			<Button
				android:id="@+id/btnRedo"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:enabled="false"
				style="?attr/materialIconButtonStyle"
				app:icon="@drawable/icon_redo_round" />
			<Button
				android:id="@+id/btnTheme"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				style="?attr/materialIconButtonStyle"
				app:icon="@drawable/icon_theme_round" />
		</LinearLayout>
		<LinearLayout
			android:id="@+id/linear8"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal">
			<LinearLayout
				android:id="@+id/linear9"
				android:layout_width="wrap_content"
				android:layout_height="match_parent"
				android:padding="4dp"
				android:gravity="center_horizontal|bottom"
				android:orientation="vertical"
				android:layout_weight="1">
				<Button
					android:id="@+id/button5"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:textSize="12sp"
					android:textColor="#000000"
					style="?attr/materialIconButtonFilledStyle"
					app:icon="@drawable/icon_web_round" />
				<Button
					android:id="@+id/button4"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:textSize="12sp"
					android:textColor="#000000"
					style="?attr/materialIconButtonFilledStyle"
					app:icon="@drawable/icon_save_round" />
				<Button
					android:id="@+id/btnExport"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:textSize="12sp"
					style="?attr/materialIconButtonFilledStyle"
					app:icon="@drawable/icon_export_round" />
			</LinearLayout>
			<LinearLayout
				android:id="@+id/scre"
				android:layout_width="wrap_content"
				android:layout_height="420dp"
				android:orientation="vertical">
				<androidx.core.widget.NestedScrollView
					android:id="@+id/vscroll2"
					android:layout_width="match_parent"
					android:layout_height="match_parent">
					<LinearLayout
						android:id="@+id/screen"
						android:layout_width="240dp"
						android:layout_height="420dp"
						android:padding="4dp"
						android:gravity="center_horizontal|top"
						android:orientation="vertical"
						android:layout_gravity="center_horizontal|center_vertical"
						android:minHeight="420dp" />
				</androidx.core.widget.NestedScrollView>
			</LinearLayout>
			<LinearLayout
				android:id="@+id/linear10"
				android:layout_width="wrap_content"
				android:layout_height="match_parent"
				android:padding="4dp"
				android:gravity="center_horizontal|bottom"
				android:orientation="vertical"
				android:layout_weight="1">
				<Button
					android:id="@+id/delete"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:textSize="12sp"
					android:textColor="#000000"
					android:enabled="false"
					style="?attr/materialIconButtonFilledStyle"
					app:icon="@drawable/icon_delete_round" />
			</LinearLayout>
		</LinearLayout>
		<LinearLayout
			android:id="@+id/linear3"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:padding="8dp"
			android:orientation="vertical">
			<com.google.android.material.button.MaterialButtonToggleGroup
				android:id="@+id/linear7"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:orientation="horizontal"
				android:layout_gravity="center_horizontal|center_vertical"
				app:singleSelection="true"
				app:selectionRequired="true">
				<Button
					android:id="@+id/button1"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:padding="8dp"
					android:text="Widgets"
					android:textSize="12sp"
					app:icon="@drawable/icon_widgets_round"
					style="?attr/materialButtonOutlinedStyle"
					android:textColor="?attr/colorOnSurface" />
				<Button
					android:id="@+id/button2"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:padding="8dp"
					android:text="Design"
					android:textSize="12sp"
					app:icon="@drawable/icon_design_services_round"
					style="?attr/materialButtonOutlinedStyle"
					android:textColor="?attr/colorOnSurface" />
				<Button
					android:id="@+id/button3"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:padding="8dp"
					android:text="Functions"
					android:textSize="12sp"
					app:icon="@drawable/icon_build_round"
					style="?attr/materialButtonOutlinedStyle"
					android:textColor="?attr/colorOnSurface" />
			</com.google.android.material.button.MaterialButtonToggleGroup>
			<TextView
				android:id="@+id/textview2"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:padding="8dp"
				android:text="No widget selected"
				android:textSize="12sp"
				android:textColor="?attr/colorOnSurfaceVariant" />
			<androidx.recyclerview.widget.RecyclerView
				android:id="@+id/recyclerview3"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				tools:listitem="@layout/design" />
			<androidx.recyclerview.widget.RecyclerView
				android:id="@+id/recyclerview1"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:visibility="gone"
				tools:listitem="@layout/widgets" />
		</LinearLayout>
	</LinearLayout>
</LinearLayout>
