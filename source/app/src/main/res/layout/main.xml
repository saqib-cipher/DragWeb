<androidx.drawerlayout.widget.DrawerLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/_main"
	android:layout_width="match_parent"
	android:layout_height="match_parent">

	<!-- Main Content Area -->
	<LinearLayout
		android:id="@+id/main"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:orientation="vertical"
		android:background="?attr/colorSurface">

		<!-- Top Bar -->
		<LinearLayout
			android:id="@+id/topBar"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="2dp"
			android:gravity="center_vertical"
			android:orientation="horizontal"
			android:background="?attr/colorSurfaceContainerHigh">
			<Button
				android:id="@+id/btnDrawer"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				style="?attr/materialIconButtonStyle"
				app:icon="@drawable/icon_widgets_round" />
			<Button
				android:id="@+id/btnBack"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="‹"
				android:textSize="18sp"
				style="?attr/materialIconButtonStyle" />
			<TextView
				android:id="@+id/tvProjectTitle"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:text="DragWeb"
				android:textSize="14sp"
				android:textStyle="bold"
				android:textColor="?attr/colorOnSurface"
				android:singleLine="true"
				android:ellipsize="end"
				android:paddingLeft="4dp" />
			<Button
				android:id="@+id/button4"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				style="?attr/materialIconButtonFilledStyle"
				app:icon="@drawable/icon_save_round" />
			<Button
				android:id="@+id/btnUndo"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:enabled="false"
				style="?attr/materialIconButtonStyle"
				app:icon="@drawable/icon_undo_round" />
			<Button
				android:id="@+id/btnRedo"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:enabled="false"
				style="?attr/materialIconButtonStyle"
				app:icon="@drawable/icon_redo_round" />
			<Button
				android:id="@+id/btnTheme"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				style="?attr/materialIconButtonStyle"
				app:icon="@drawable/icon_theme_round" />
		</LinearLayout>

		<!-- Tab Bar: View / Event / Component -->
		<com.google.android.material.tabs.TabLayout
			android:id="@+id/tabLayout"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			app:tabMode="fixed"
			app:tabGravity="fill"
			app:tabIndicatorColor="?attr/colorPrimary"
			app:tabSelectedTextColor="?attr/colorPrimary"
			app:tabTextColor="?attr/colorOnSurfaceVariant"
			android:background="?attr/colorSurfaceContainerHigh">
			<com.google.android.material.tabs.TabItem
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="View" />
			<com.google.android.material.tabs.TabItem
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Event" />
			<com.google.android.material.tabs.TabItem
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Component" />
		</com.google.android.material.tabs.TabLayout>

		<!-- Horizontal Middle Area (Canvas + Right Panel) -->
		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="0dp"
			android:layout_weight="1"
			android:orientation="horizontal">

			<!-- Center pane: Design Canvas -->
			<LinearLayout
				android:layout_width="0dp"
				android:layout_height="match_parent"
				android:layout_weight="1"
				android:padding="4dp"
				android:orientation="vertical">
				<FrameLayout
					android:layout_width="match_parent"
					android:layout_height="match_parent">
					<LinearLayout
						android:id="@+id/scre"
						android:layout_width="match_parent"
						android:layout_height="match_parent"
						android:gravity="center"
						android:orientation="vertical">
						<androidx.core.widget.NestedScrollView
							android:id="@+id/vscroll2"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content">
							<LinearLayout
								android:id="@+id/screen"
								android:layout_width="320dp"
								android:layout_height="540dp"
								android:padding="4dp"
								android:gravity="center_horizontal|top"
								android:orientation="vertical"
								android:background="?attr/colorSurface"
								android:elevation="4dp"
								android:minHeight="540dp" />
						</androidx.core.widget.NestedScrollView>
					</LinearLayout>

					<!-- Event panel (hidden by default, shown on Event tab) -->
					<LinearLayout
						android:id="@+id/eventPanel"
						android:layout_width="match_parent"
						android:layout_height="match_parent"
					android:orientation="vertical"
					android:padding="16dp"
					android:visibility="gone">
					<TextView
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:text="Logic Blocks"
						android:textSize="16sp"
						android:textStyle="bold"
						android:textColor="?attr/colorOnSurface"
						android:paddingBottom="8dp" />
					<TextView
						android:id="@+id/tvEventHint"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:text="Select a widget and add events.\nEvents: click, hover, input, load\nActions: change style, animate, navigate, show/hide"
						android:textSize="13sp"
						android:textColor="?attr/colorOnSurfaceVariant"
						android:paddingBottom="12dp" />
					<Button
						android:id="@+id/btnAddLogicBlock"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:text="+ Add Logic Block"
						style="?attr/materialButtonOutlinedStyle" />
					<Button
						android:id="@+id/btnViewAllBlocks"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:text="View All Blocks"
						android:layout_marginTop="8dp"
						style="?attr/materialButtonOutlinedStyle" />
				</LinearLayout>
				</FrameLayout>
			</LinearLayout>

			<!-- Right side panel: Hierarchy Tree -->
			<LinearLayout
				android:id="@+id/rightPanel"
				android:layout_width="120dp"
				android:layout_height="match_parent"
				android:orientation="vertical"
				android:background="?attr/colorSurfaceContainer"
				android:padding="2dp">
				<TextView
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:text="Hierarchy"
					android:textSize="11sp"
					android:textStyle="bold"
					android:textColor="?attr/colorOnSurfaceVariant"
					android:gravity="center"
					android:paddingTop="4dp"
					android:paddingBottom="4dp" />
				<androidx.recyclerview.widget.RecyclerView
					android:id="@+id/recyclerviewRightPanel"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:clipToPadding="false" />
			</LinearLayout>
		</LinearLayout>

		<!-- Bottom Panel -->
		<LinearLayout
			android:id="@+id/bottomPanel"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:background="?attr/colorSurfaceContainerHigh"
			android:padding="6dp">

			<!-- Top row: Styles horizontal list -->
			<HorizontalScrollView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:scrollbars="none">
				<LinearLayout
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:orientation="horizontal">
					<androidx.recyclerview.widget.RecyclerView
						android:id="@+id/recyclerview3"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:orientation="horizontal"
						tools:listitem="@layout/design" />
				</LinearLayout>
			</HorizontalScrollView>

			<!-- Tabs: Basic / Recent / Event -->
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="horizontal"
				android:layout_marginTop="4dp"
				android:layout_marginBottom="4dp">
				<com.google.android.material.chip.Chip
					android:id="@+id/chipBasic"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Basic"
					android:textSize="11sp"
					style="@style/Widget.Material3.Chip.Filter"
					android:checked="true" />
				<com.google.android.material.chip.Chip
					android:id="@+id/chipStyles"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Styles"
					android:textSize="11sp"
					style="@style/Widget.Material3.Chip.Filter" />
				<com.google.android.material.chip.Chip
					android:id="@+id/chipEvent"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Event"
					android:textSize="11sp"
					style="@style/Widget.Material3.Chip.Filter" />
			</LinearLayout>

			<!-- Bottom row: Selected widget & actions -->
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="horizontal"
				android:gravity="center_vertical">

				<Spinner
					android:id="@+id/widgetSpinner"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:minHeight="40dp" />

				<TextView
					android:id="@+id/textview2"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="No selection"
					android:textSize="11sp"
					android:visibility="gone" />

				<Button
					android:id="@+id/delete"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:enabled="false"
					style="?attr/materialIconButtonFilledStyle"
					app:icon="@drawable/icon_delete_round" />

				<Button
					android:id="@+id/button5"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					style="?attr/materialIconButtonFilledStyle"
					app:icon="@drawable/icon_web_round" />

				<Button
					android:id="@+id/btnExport"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					style="?attr/materialIconButtonFilledStyle"
					app:icon="@drawable/icon_export_round" />

				<Button
					android:id="@+id/btnViewStyles"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					style="?attr/materialIconButtonStyle"
					app:icon="@drawable/icon_design_services_round" />
			</LinearLayout>
		</LinearLayout>
	</LinearLayout>

	<!-- Left Drawer: Widget Palette with Categories -->
	<LinearLayout
		android:layout_width="280dp"
		android:layout_height="match_parent"
		android:layout_gravity="start"
		android:background="?attr/colorSurface"
		android:padding="8dp"
		android:orientation="vertical">
		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="Widgets"
			android:textSize="18sp"
			android:textStyle="bold"
			android:paddingBottom="4dp" />

		<!-- Widget Category Tabs -->
		<com.google.android.material.tabs.TabLayout
			android:id="@+id/tabWidgetCategories"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			app:tabMode="scrollable"
			app:tabGravity="start"
			app:tabIndicatorColor="?attr/colorPrimary"
			app:tabSelectedTextColor="?attr/colorPrimary"
			app:tabTextColor="?attr/colorOnSurfaceVariant"
			app:tabMinWidth="50dp"
			android:paddingBottom="4dp">
			<com.google.android.material.tabs.TabItem
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="All" />
			<com.google.android.material.tabs.TabItem
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Layout" />
			<com.google.android.material.tabs.TabItem
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Basic" />
			<com.google.android.material.tabs.TabItem
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Form" />
			<com.google.android.material.tabs.TabItem
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Media" />
			<com.google.android.material.tabs.TabItem
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Adv." />
		</com.google.android.material.tabs.TabLayout>

		<!-- Widget list -->
		<androidx.recyclerview.widget.RecyclerView
			android:id="@+id/recyclerview1"
			android:layout_width="match_parent"
			android:layout_height="0dp"
			android:layout_weight="1"
			tools:listitem="@layout/widgets" />

		<!-- Asset Manager Section -->
		<View
			android:layout_width="match_parent"
			android:layout_height="1dp"
			android:background="?attr/colorOutlineVariant"
			android:layout_marginTop="8dp"
			android:layout_marginBottom="4dp" />
		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="Assets"
			android:textSize="14sp"
			android:textStyle="bold"
			android:paddingBottom="4dp" />
		<Button
			android:id="@+id/btnImportImage"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="Import Image"
			android:textSize="12sp"
			style="?attr/materialButtonOutlinedStyle" />
		<Button
			android:id="@+id/btnImportWidgets"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="Import JSON Widgets"
			android:textSize="12sp"
			android:layout_marginTop="4dp"
			style="?attr/materialButtonOutlinedStyle" />
	</LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
