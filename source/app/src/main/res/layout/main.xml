<androidx.drawerlayout.widget.DrawerLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/_main"
	android:layout_width="match_parent"
	android:layout_height="match_parent">

	<!-- Main Content Area -->
	<LinearLayout
		android:id="@+id/main"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:orientation="vertical"
		android:background="?attr/colorSurface">

		<!-- Top Bar -->
		<LinearLayout
			android:id="@+id/topBar"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="2dp"
			android:gravity="center_vertical"
			android:orientation="horizontal"
			android:background="?attr/colorSurfaceContainerHigh">
			<Button
				android:id="@+id/btnDrawer"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				style="?attr/materialIconButtonStyle"
				app:icon="@drawable/icon_widgets_round" />
			<Button
				android:id="@+id/btnBack"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="&#8249;"
				android:textSize="18sp"
				style="?attr/materialIconButtonStyle" />
			<TextView
				android:id="@+id/tvProjectTitle"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:text="DragWeb"
				android:textSize="14sp"
				android:textStyle="bold"
				android:textColor="?attr/colorOnSurface"
				android:singleLine="true"
				android:ellipsize="end"
				android:paddingLeft="4dp" />

			<!-- Page selector spinner -->
			<Spinner
				android:id="@+id/spnPageSelector"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:minWidth="80dp"
				android:minHeight="36dp" />

			<Button
				android:id="@+id/btnAddPage"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="+"
				android:textSize="14sp"
				style="?attr/materialIconButtonStyle" />

			<Button
				android:id="@+id/button4"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				style="?attr/materialIconButtonFilledStyle"
				app:icon="@drawable/icon_save_round" />
			<Button
				android:id="@+id/btnUndo"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:enabled="false"
				style="?attr/materialIconButtonStyle"
				app:icon="@drawable/icon_undo_round" />
			<Button
				android:id="@+id/btnRedo"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:enabled="false"
				style="?attr/materialIconButtonStyle"
				app:icon="@drawable/icon_redo_round" />
			<Button
				android:id="@+id/btnTheme"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				style="?attr/materialIconButtonStyle"
				app:icon="@drawable/icon_theme_round" />
		</LinearLayout>

		<!-- Tab Bar: View / Event / Assets -->
		<com.google.android.material.tabs.TabLayout
			android:id="@+id/tabLayout"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			app:tabMode="fixed"
			app:tabGravity="fill"
			app:tabIndicatorColor="?attr/colorPrimary"
			app:tabSelectedTextColor="?attr/colorPrimary"
			app:tabTextColor="?attr/colorOnSurfaceVariant"
			android:background="?attr/colorSurfaceContainerHigh">
			<com.google.android.material.tabs.TabItem
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="View" />
			<com.google.android.material.tabs.TabItem
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Event" />
			<com.google.android.material.tabs.TabItem
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Assets" />
		</com.google.android.material.tabs.TabLayout>

		<!-- Main Area: Canvas + Side Panels -->
		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="0dp"
			android:layout_weight="1"
			android:orientation="horizontal">

			<!-- Center pane: Design Canvas -->
			<LinearLayout
				android:layout_width="0dp"
				android:layout_height="match_parent"
				android:layout_weight="1"
				android:padding="4dp"
				android:orientation="vertical">
				<FrameLayout
					android:layout_width="match_parent"
					android:layout_height="match_parent">

					<!-- Canvas area (View tab) -->
					<androidx.core.widget.NestedScrollView
						android:id="@+id/vscroll2"
						android:layout_width="match_parent"
						android:layout_height="match_parent">
						<LinearLayout
							android:id="@+id/screen"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:padding="4dp"
							android:gravity="center_horizontal|top"
							android:orientation="vertical"
							android:background="?attr/colorSurface"
							android:elevation="2dp"
							android:minHeight="540dp" />
					</androidx.core.widget.NestedScrollView>

					<!-- Event panel (hidden by default) -->
					<LinearLayout
						android:id="@+id/eventPanel"
						android:layout_width="match_parent"
						android:layout_height="match_parent"
						android:orientation="vertical"
						android:padding="16dp"
						android:visibility="gone"
						android:background="?attr/colorSurface">

						<TextView
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:text="Logic Blocks"
							android:textSize="16sp"
							android:textStyle="bold"
							android:textColor="?attr/colorOnSurface"
							android:paddingBottom="8dp" />
						<TextView
							android:id="@+id/tvEventHint"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:text="Add logic blocks: select target by id, class, or tag.\nDrag blocks vertically to reorder flow."
							android:textSize="13sp"
							android:textColor="?attr/colorOnSurfaceVariant"
							android:paddingBottom="12dp" />

						<ScrollView
							android:layout_width="match_parent"
							android:layout_height="0dp"
							android:layout_weight="1"
							android:layout_marginBottom="8dp">
							<LinearLayout
								android:id="@+id/blockContainer"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:orientation="vertical" />
						</ScrollView>

						<Button
							android:id="@+id/btnAddLogicBlock"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:text="+ Add Logic Block"
							style="?attr/materialButtonOutlinedStyle" />
						<Button
							android:id="@+id/btnViewAllBlocks"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:text="View All Blocks"
							android:layout_marginTop="8dp"
							style="?attr/materialButtonOutlinedStyle" />
					</LinearLayout>

					<!-- Assets panel (file explorer - hidden by default) -->
					<LinearLayout
						android:id="@+id/assetsPanel"
						android:layout_width="match_parent"
						android:layout_height="match_parent"
						android:orientation="vertical"
						android:padding="16dp"
						android:visibility="gone"
						android:background="?attr/colorSurface">

						<LinearLayout
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:orientation="horizontal"
							android:gravity="center_vertical"
							android:paddingBottom="8dp">
							<TextView
								android:layout_width="0dp"
								android:layout_height="wrap_content"
								android:layout_weight="1"
								android:text="File Explorer"
								android:textSize="16sp"
								android:textStyle="bold"
								android:textColor="?attr/colorOnSurface" />
							<Button
								android:id="@+id/btnImportImage"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="Import"
								android:textSize="12sp"
								style="?attr/materialButtonOutlinedStyle" />
							<Button
								android:id="@+id/btnNewFolder"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="New Folder"
								android:textSize="12sp"
								android:layout_marginStart="4dp"
								style="?attr/materialButtonOutlinedStyle" />
						</LinearLayout>

						<!-- Current path breadcrumb -->
						<TextView
							android:id="@+id/tvAssetsPath"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:text="/assets/"
							android:textSize="12sp"
							android:textColor="?attr/colorOnSurfaceVariant"
							android:paddingBottom="8dp"
							android:singleLine="true"
							android:ellipsize="start" />

						<!-- File list -->
						<androidx.recyclerview.widget.RecyclerView
							android:id="@+id/rvAssets"
							android:layout_width="match_parent"
							android:layout_height="0dp"
							android:layout_weight="1"
							android:layout_marginTop="4dp"
							android:clipToPadding="false" />

						<!-- Hidden buttons kept for backwards compat -->
						<Button
							android:id="@+id/btnImportWidgets"
							android:layout_width="0dp"
							android:layout_height="0dp"
							android:visibility="gone" />
						<Button
							android:id="@+id/btnImportSvg"
							android:layout_width="0dp"
							android:layout_height="0dp"
							android:visibility="gone" />
					</LinearLayout>
				</FrameLayout>
			</LinearLayout>

			<!-- Right side panel: Widgets + Hierarchy stacked -->
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/rightPanelCard"
				android:layout_width="180dp"
				android:layout_height="match_parent"
				android:layout_margin="4dp"
				app:cardCornerRadius="12dp"
				app:cardElevation="2dp"
				app:cardBackgroundColor="?attr/colorSurfaceContainer">
				<LinearLayout
					android:id="@+id/rightPanel"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:orientation="vertical"
					android:padding="6dp">

					<!-- Hierarchy section -->
					<TextView
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:text="Hierarchy"
						android:textSize="14sp"
						android:textStyle="bold"
						android:textColor="?attr/colorOnSurface"
						android:gravity="center"
						android:paddingTop="2dp"
						android:paddingBottom="4dp" />

					<!-- Widget search in hierarchy -->
					<com.google.android.material.textfield.TextInputLayout
						android:id="@+id/searchHierarchyLayout"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:hint="Find..."
						app:boxCornerRadiusTopStart="8dp"
						app:boxCornerRadiusTopEnd="8dp"
						app:boxCornerRadiusBottomStart="8dp"
						app:boxCornerRadiusBottomEnd="8dp"
						style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense">
						<com.google.android.material.textfield.TextInputEditText
							android:id="@+id/etSearchHierarchy"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:textSize="11sp"
							android:inputType="text"
							android:maxLines="1" />
					</com.google.android.material.textfield.TextInputLayout>

					<androidx.recyclerview.widget.RecyclerView
						android:id="@+id/recyclerviewRightPanel"
						android:layout_width="match_parent"
						android:layout_height="0dp"
						android:layout_weight="1"
						android:layout_marginTop="4dp"
						android:clipToPadding="false" />

					<!-- Divider -->
					<View
						android:layout_width="match_parent"
						android:layout_height="1dp"
						android:background="?attr/colorOutlineVariant"
						android:layout_marginVertical="4dp" />

					<!-- Widget palette inline section -->
					<TextView
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:text="Widgets"
						android:textSize="14sp"
						android:textStyle="bold"
						android:textColor="?attr/colorOnSurface"
						android:gravity="center"
						android:paddingBottom="4dp" />

					<!-- Category chips (compact) -->
					<HorizontalScrollView
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:scrollbars="none">
						<com.google.android.material.chip.ChipGroup
							android:id="@+id/chipGroupCategories"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							app:singleSelection="true"
							app:singleLine="true">
							<com.google.android.material.chip.Chip
								android:id="@+id/chipCatAll"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="All"
								android:textSize="9sp"
								android:checked="true"
								style="@style/Widget.Material3.Chip.Filter" />
							<com.google.android.material.chip.Chip
								android:id="@+id/chipCatLayout"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="Layout"
								android:textSize="9sp"
								style="@style/Widget.Material3.Chip.Filter" />
							<com.google.android.material.chip.Chip
								android:id="@+id/chipCatBasic"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="Basic"
								android:textSize="9sp"
								style="@style/Widget.Material3.Chip.Filter" />
							<com.google.android.material.chip.Chip
								android:id="@+id/chipCatForm"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="Form"
								android:textSize="9sp"
								style="@style/Widget.Material3.Chip.Filter" />
							<com.google.android.material.chip.Chip
								android:id="@+id/chipCatMedia"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="Media"
								android:textSize="9sp"
								style="@style/Widget.Material3.Chip.Filter" />
							<com.google.android.material.chip.Chip
								android:id="@+id/chipCatAdvanced"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="Adv"
								android:textSize="9sp"
								style="@style/Widget.Material3.Chip.Filter" />
						</com.google.android.material.chip.ChipGroup>
					</HorizontalScrollView>

					<!-- Widget list (vertical) -->
					<androidx.recyclerview.widget.RecyclerView
						android:id="@+id/recyclerview1"
						android:layout_width="match_parent"
						android:layout_height="0dp"
						android:layout_weight="1"
						android:layout_marginTop="2dp"
						android:clipToPadding="false"
						tools:listitem="@layout/widgets" />
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
		</LinearLayout>

		<!-- Bottom Panel: Style Management -->
		<LinearLayout
			android:id="@+id/bottomPanel"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:background="?attr/colorSurfaceContainerHigh"
			android:padding="6dp">

			<!-- Style items horizontal list -->
			<HorizontalScrollView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:scrollbars="none">
				<LinearLayout
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:orientation="horizontal">
					<androidx.recyclerview.widget.RecyclerView
						android:id="@+id/recyclerview3"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:orientation="horizontal"
						tools:listitem="@layout/design" />
				</LinearLayout>
			</HorizontalScrollView>

			<!-- Tabs: Basic / Styles / Layout -->
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="horizontal"
				android:layout_marginTop="4dp"
				android:layout_marginBottom="4dp">
				<com.google.android.material.chip.Chip
					android:id="@+id/chipBasic"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Basic"
					android:textSize="11sp"
					style="@style/Widget.Material3.Chip.Filter"
					android:checked="true" />
				<com.google.android.material.chip.Chip
					android:id="@+id/chipStyles"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Styles"
					android:textSize="11sp"
					style="@style/Widget.Material3.Chip.Filter" />
				<com.google.android.material.chip.Chip
					android:id="@+id/chipLayout"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Layout"
					android:textSize="11sp"
					style="@style/Widget.Material3.Chip.Filter" />
				<com.google.android.material.chip.Chip
					android:id="@+id/chipEvent"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Event"
					android:textSize="11sp"
					android:visibility="gone"
					style="@style/Widget.Material3.Chip.Filter" />
			</LinearLayout>

			<!-- Bottom row: Selected widget & actions -->
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="horizontal"
				android:gravity="center_vertical">

				<Spinner
					android:id="@+id/widgetSpinner"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:minHeight="40dp" />

				<TextView
					android:id="@+id/textview2"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="No selection"
					android:textSize="11sp"
					android:visibility="gone" />

				<!-- Copy widget button -->
				<Button
					android:id="@+id/btnCopyWidget"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					style="?attr/materialIconButtonStyle"
					app:icon="@drawable/icon_copy_all_round" />

				<Button
					android:id="@+id/delete"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:enabled="false"
					style="?attr/materialIconButtonFilledStyle"
					app:icon="@drawable/icon_delete_round" />

				<Button
					android:id="@+id/button5"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					style="?attr/materialIconButtonFilledStyle"
					app:icon="@drawable/icon_web_round" />

				<Button
					android:id="@+id/btnExport"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					style="?attr/materialIconButtonFilledStyle"
					app:icon="@drawable/icon_export_round" />

				<Button
					android:id="@+id/btnViewStyles"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					style="?attr/materialIconButtonStyle"
					app:icon="@drawable/icon_design_services_round" />
			</LinearLayout>
		</LinearLayout>
	</LinearLayout>

	<!-- Left Drawer: Widget Palette + Settings -->
	<LinearLayout
		android:layout_width="300dp"
		android:layout_height="match_parent"
		android:layout_gravity="start"
		android:background="?attr/colorSurface"
		android:orientation="vertical">

		<!-- Drawer header -->
		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal"
			android:padding="12dp"
			android:gravity="center_vertical"
			android:background="?attr/colorSurfaceContainerHigh">
			<ImageView
				android:layout_width="24dp"
				android:layout_height="24dp"
				android:src="@drawable/icon_widgets_round"
				app:tint="?attr/colorPrimary" />
			<TextView
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:text="Widget Palette"
				android:textSize="16sp"
				android:textStyle="bold"
				android:textColor="?attr/colorOnSurface"
				android:paddingLeft="8dp" />
		</LinearLayout>

		<!-- Search bar for widgets -->
		<com.google.android.material.textfield.TextInputLayout
			android:id="@+id/searchWidgetLayout"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginStart="8dp"
			android:layout_marginEnd="8dp"
			android:layout_marginTop="8dp"
			android:hint="Search widgets..."
			app:boxCornerRadiusTopStart="8dp"
			app:boxCornerRadiusTopEnd="8dp"
			app:boxCornerRadiusBottomStart="8dp"
			app:boxCornerRadiusBottomEnd="8dp"
			style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense">
			<com.google.android.material.textfield.TextInputEditText
				android:id="@+id/etSearchWidget"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:textSize="13sp"
				android:inputType="text"
				android:maxLines="1" />
		</com.google.android.material.textfield.TextInputLayout>

		<!-- Widget category chips in drawer -->
		<HorizontalScrollView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:scrollbars="none"
			android:layout_marginTop="4dp"
			android:paddingLeft="8dp"
			android:paddingRight="8dp">
			<com.google.android.material.chip.ChipGroup
				android:id="@+id/chipGroupDrawerCategories"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				app:singleSelection="true"
				app:singleLine="true">
				<com.google.android.material.chip.Chip
					android:id="@+id/chipDrawerAll"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="All"
					android:textSize="11sp"
					android:checked="true"
					style="@style/Widget.Material3.Chip.Filter" />
				<com.google.android.material.chip.Chip
					android:id="@+id/chipDrawerLayout"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Layout"
					android:textSize="11sp"
					style="@style/Widget.Material3.Chip.Filter" />
				<com.google.android.material.chip.Chip
					android:id="@+id/chipDrawerBasic"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Basic"
					android:textSize="11sp"
					style="@style/Widget.Material3.Chip.Filter" />
				<com.google.android.material.chip.Chip
					android:id="@+id/chipDrawerForm"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Form"
					android:textSize="11sp"
					style="@style/Widget.Material3.Chip.Filter" />
			</com.google.android.material.chip.ChipGroup>
		</HorizontalScrollView>

		<!-- Widget list in drawer (vertical) with bigger text -->
		<androidx.recyclerview.widget.RecyclerView
			android:id="@+id/rvDrawerWidgets"
			android:layout_width="match_parent"
			android:layout_height="0dp"
			android:layout_weight="1"
			android:layout_marginTop="4dp"
			android:paddingLeft="8dp"
			android:paddingRight="8dp"
			android:clipToPadding="false"
			tools:listitem="@layout/widgets" />

		<!-- Drawer bottom: Custom configs -->
		<View
			android:layout_width="match_parent"
			android:layout_height="1dp"
			android:background="?attr/colorOutlineVariant" />

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:padding="8dp">

			<Button
				android:id="@+id/btnLoadCustomWidgets"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="Load Custom Widgets JSON"
				android:textSize="11sp"
				style="?attr/materialButtonOutlinedStyle" />

			<Button
				android:id="@+id/btnLoadCustomBlocks"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="Load Custom Blocks JSON"
				android:textSize="11sp"
				android:layout_marginTop="4dp"
				style="?attr/materialButtonOutlinedStyle" />
		</LinearLayout>
	</LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
