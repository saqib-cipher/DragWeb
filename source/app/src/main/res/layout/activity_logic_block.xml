<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarLogic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainerHigh"
        app:title="Logic Blocks"
        app:subtitle="Page Event"
        app:titleTextColor="?attr/colorOnSurface"
        app:subtitleTextColor="?attr/colorOnSurfaceVariant"
        app:navigationIcon="@drawable/icon_arrow_back_round"
        app:navigationIconTint="?attr/colorOnSurface" />

    <!-- Target Widget Selector Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="10dp"
        android:background="?attr/colorSurfaceContainer">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Target:"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:paddingEnd="6dp" />

        <Spinner
            android:id="@+id/spnTargetMode"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="70dp"
            android:background="?attr/colorSurfaceContainerHighest" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:hint="Element selector"
            app:boxCornerRadiusTopStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusBottomEnd="10dp"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense">
            <AutoCompleteTextView
                android:id="@+id/etTargetSelector"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:textSize="12sp"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:completionThreshold="1" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <!-- Block Category Tabs -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabBlockCategories"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabMode="scrollable"
        app:tabGravity="start"
        app:tabIndicatorColor="?attr/colorPrimary"
        app:tabSelectedTextColor="?attr/colorPrimary"
        app:tabTextColor="?attr/colorOnSurfaceVariant"
        android:background="?attr/colorSurfaceContainerHigh">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Events" />
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CSS" />
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HTML" />
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Logic" />
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Variables" />
    </com.google.android.material.tabs.TabLayout>

    <!-- Block Palette (horizontal scrollable) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:background="?attr/colorSurfaceContainer"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/blockPaletteContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp" />
    </HorizontalScrollView>

    <!-- Toolbar: Undo, Redo, Copy, View JS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="4dp"
        android:background="?attr/colorSurfaceContainerHigh">

        <Button
            android:id="@+id/btnBlockUndo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Undo"
            android:textSize="11sp"
            style="?attr/materialIconButtonStyle"
            app:icon="@drawable/icon_undo_round" />

        <Button
            android:id="@+id/btnBlockRedo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Redo"
            android:textSize="11sp"
            style="?attr/materialIconButtonStyle"
            app:icon="@drawable/icon_redo_round" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Block count indicator -->
        <TextView
            android:id="@+id/tvBlockCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 blocks"
            android:textSize="11sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:paddingEnd="8dp" />

        <Button
            android:id="@+id/btnBlockViewJs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="View JS"
            android:textSize="11sp"
            style="?attr/materialButtonOutlinedStyle" />

        <Button
            android:id="@+id/btnBlockAdd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ Add"
            android:textSize="11sp"
            android:layout_marginStart="6dp"
            style="?attr/materialButtonStyle" />
    </LinearLayout>

    <!-- Block Workspace (drop area) -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/blockWorkspace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp"
            android:minHeight="300dp" />
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
