<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical"
	android:padding="24dp"
	android:gravity="center_horizontal">

	<ImageView
		android:layout_width="72dp"
		android:layout_height="72dp"
		android:src="@mipmap/ic_launcher"
		android:contentDescription="App icon" />

	<TextView
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:text="DragWeb"
		android:textSize="22sp"
		android:textStyle="bold"
		android:textColor="?attr/colorOnSurface"
		android:paddingTop="12dp" />

	<TextView
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:text="No-Code Web Builder"
		android:textSize="14sp"
		android:textColor="?attr/colorOnSurfaceVariant"
		android:paddingTop="4dp" />

	<TextView
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:text="Version 1.0"
		android:textSize="12sp"
		android:textColor="?attr/colorOnSurfaceVariant"
		android:paddingTop="8dp" />

	<View
		android:layout_width="match_parent"
		android:layout_height="1dp"
		android:background="?attr/colorOutlineVariant"
		android:layout_marginTop="16dp"
		android:layout_marginBottom="16dp" />

	<TextView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:text="A professional no-code web builder for Android, inspired by Sketchware Pro. Build modern websites with drag-and-drop, real-time preview, and export clean HTML/CSS/JS."
		android:textSize="13sp"
		android:textColor="?attr/colorOnSurfaceVariant"
		android:gravity="center" />

	<TextView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:text="\nFeatures:\n• Drag and drop web widgets\n• Real-time WebView preview\n• CSS-like styling system\n• Visual logic blocks\n• Export HTML/CSS/JS\n• Responsive design testing\n• Project backup and restore"
		android:textSize="12sp"
		android:textColor="?attr/colorOnSurfaceVariant"
		android:paddingTop="12dp" />

	<Button
		android:id="@+id/btnGithub"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:text="View on GitHub"
		android:layout_marginTop="16dp"
		style="?attr/materialButtonOutlinedStyle" />
</LinearLayout>
