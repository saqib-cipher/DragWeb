<com.google.android.material.card.MaterialCardView
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:id="@+id/cardProject"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:layout_marginLeft="16dp"
	android:layout_marginRight="16dp"
	android:layout_marginTop="4dp"
	android:layout_marginBottom="4dp"
	app:cardElevation="2dp"
	app:cardCornerRadius="12dp"
	android:clickable="true"
	android:focusable="true"
	app:cardBackgroundColor="?attr/colorSurfaceContainerHigh">
	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal"
		android:padding="16dp"
		android:gravity="center_vertical">
		<LinearLayout
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:gravity="center"
			android:background="@drawable/icon_web_round">
			<ImageView
				android:id="@+id/imgProjectIcon"
				android:layout_width="28dp"
				android:layout_height="28dp"
				android:src="@drawable/icon_web_round"
				app:tint="?attr/colorPrimary" />
		</LinearLayout>
		<LinearLayout
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:orientation="vertical"
			android:layout_marginLeft="16dp">
			<TextView
				android:id="@+id/tvProjectName"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Project Name"
				android:textSize="16sp"
				android:textStyle="bold"
				android:textColor="?attr/colorOnSurface" />
			<TextView
				android:id="@+id/tvProjectId"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="ID: ..."
				android:textSize="10sp"
				android:textColor="?attr/colorOutline"
				android:fontFamily="monospace"
				android:layout_marginTop="1dp" />
			<TextView
				android:id="@+id/tvProjectDescription"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Description"
				android:textSize="12sp"
				android:textColor="?attr/colorOnSurfaceVariant"
				android:layout_marginTop="2dp" />
			<TextView
				android:id="@+id/tvProjectDate"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="Created: ..."
				android:textSize="10sp"
				android:textColor="?attr/colorOutline"
				android:layout_marginTop="4dp" />
		</LinearLayout>
		<LinearLayout
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:gravity="center">
			<ImageView
				android:id="@+id/btnProjectBackup"
				android:layout_width="32dp"
				android:layout_height="32dp"
				android:padding="4dp"
				android:src="@drawable/icon_save_round"
				app:tint="?attr/colorPrimary"
				android:background="?attr/selectableItemBackgroundBorderless"
				android:contentDescription="Backup" />
			<ImageView
				android:id="@+id/btnProjectMenu"
				android:layout_width="32dp"
				android:layout_height="32dp"
				android:padding="4dp"
				android:src="@drawable/icon_delete_round"
				app:tint="?attr/colorOnSurfaceVariant"
				android:background="?attr/selectableItemBackgroundBorderless"
				android:layout_marginTop="4dp" />
		</LinearLayout>
	</LinearLayout>
</com.google.android.material.card.MaterialCardView>
