          "presets": ["block", "none", "flex", "grid", "inline-block", "inline"]
        },
        {
          "type": "css",
          "name": "setPosition",
          "label": "Set Position",
          "description": "static, relative, absolute, fixed",
          "params": ["value"],
          "presets": ["static", "relative", "absolute", "fixed", "sticky"]
        },
        {
          "type": "css",
          "name": "setOverflow",
