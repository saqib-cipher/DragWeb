{
  "blockCategories": [
    {
      "id": "event",
      "label": "Events",
      "color": "#FF9800",
      "blocks": [
        {
          "type": "event",
          "name": "onPageLoad",
          "label": "On Page Load",
          "description": "When page finishes loading",
          "target": "tag",
          "params": ["body"]
        },
        {
          "type": "event",
          "name": "onVisible",
          "label": "On Visible",
          "description": "When page becomes visible",
          "target": "tag",
          "params": ["body"]
        },
        {
          "type": "event",
          "name": "onHidden",
          "label": "On Hidden",
          "description": "When page is hidden",
          "target": "tag",
          "params": ["body"]
        },
        {
          "type": "event",
          "name": "onDestroy",
          "label": "On Destroy",
          "description": "When page is about to unload",
          "target": "tag",
          "params": ["body"]
        },
        {
          "type": "event",
          "name": "onScroll",
          "label": "On Scroll",
          "description": "When user scrolls the page",
          "target": "tag",
          "params": ["body"]
        },
        {
          "type": "event",
          "name": "onInput",
          "label": "On Input",
          "description": "When input value changes",
          "target": "id",
          "params": ["elementId"]
        },
        {
          "type": "event",
          "name": "onClick",
          "label": "On Click",
          "description": "When element is clicked",
          "target": "id",
          "params": ["elementId"]
        },
        {
          "type": "event",
          "name": "onHover",
          "label": "On Hover",
          "description": "When mouse hovers over element",
          "target": "id",
          "params": ["elementId"]
        },
        {
          "type": "event",
          "name": "onSubmit",
          "label": "On Submit",
          "description": "When form is submitted",
          "target": "id",
          "params": ["formId"]
        },
        {
          "type": "event",
          "name": "onKeyDown",
          "label": "On Key Down",
          "description": "When key is pressed",
          "target": "id",
          "params": ["elementId"]
        },
        {
          "type": "event",
          "name": "onChange",
          "label": "On Change",
          "description": "When value changes",
          "target": "id",
          "params": ["elementId"]
        }
      ]
    },
    {
      "id": "css",
