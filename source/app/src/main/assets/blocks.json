{
  "blockCategories": [
    {
      "id": "event",
      "label": "States",
      "color": "#FF9800",
      "blocks": [
        {"type": "state", "name": "default", "label": "Default", "description": "Base styles", "target": "id", "params": ["selector"]},
        {"type": "state", "name": "hover", "label": "Hover", "description": "On hover", "target": "id", "params": ["selector"]},
        {"type": "state", "name": "focus", "label": "Focus", "description": "On focus", "target": "id", "params": ["selector"]},
        {"type": "state", "name": "active", "label": "Active", "description": "On press/active", "target": "id", "params": ["selector"]}
      ]
    },
    {
      "id": "css",
      "label": "CSS",
      "color": "#2196F3",
      "blocks": [
        {"type": "css", "name": "setDisplay", "label": "Display", "description": "block/none/flex/grid", "params": ["value"], "presets": ["block","none","flex","grid","inline"]},
        {"type": "css", "name": "setPosition", "label": "Position", "description": "static/relative/absolute", "params": ["value"], "presets": ["static","relative","absolute","fixed","sticky"]},
        {"type": "css", "name": "setColor", "label": "Color", "description": "Text color", "params": ["value"]},
        {"type": "css", "name": "setBackground", "label": "Background", "description": "Background color/gradient", "params": ["value"]},
        {"type": "css", "name": "setWidth", "label": "Width", "description": "Width", "params": ["value"]},
