[
  {
    "type": "event",
    "name": "onClick",
    "target": "id",
    "params": ["elementId"],
    "actions": [
      {
        "type": "style",
        "property": "display",
        "value": "none"
      }
    ]
  },
  {
    "type": "event",
    "name": "onHover",
    "target": "id",
    "params": ["elementId"],
    "actions": [
      {
        "type": "style",
        "property": "opacity",
        "value": "0.7"
      }
    ]
  },
  {
    "type": "event",
    "name": "onLoad",
    "target": "tag",
    "params": ["body"],
    "actions": [
      {
        "type": "style",
        "property": "opacity",
        "value": "1"
      }
    ]
  },
  {
    "type": "event",
    "name": "onInput",
    "target": "id",
    "params": ["elementId"],
    "actions": [
      {
        "type": "setText",
        "value": ""
      }
    ]
  },
  {
    "type": "event",
    "name": "onSubmit",
    "target": "id",
    "params": ["formId"],
    "actions": [
      {
        "type": "alert",
        "value": "Form submitted!"
      }
    ]
  },
  {
    "type": "event",
    "name": "onScroll",
    "target": "tag",
    "params": ["body"],
    "actions": [
      {
        "type": "addClass",
        "value": "scrolled"
      }
    ]
  },
  {
