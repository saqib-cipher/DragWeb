        },
        {
          "type": "css",
          "name": "setFlex",
          "label": "Set Flex",
          "description": "Flex layout properties",
          "params": ["value"]
        },
        {
          "type": "css",
          "name": "setTransform",
          "label": "Set Transform",
          "description": "rotate, scale, translate",
          "params": ["value"]
        },
        {
          "type": "css",
          "name": "setTransition",
          "label": "Set Transition",
          "description": "CSS transition animation",
          "params": ["value"]
        },
        {
          "type": "css",
          "name": "addClass",
          "label": "Add Class",
