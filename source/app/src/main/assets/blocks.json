    {
      "id": "logic",
      "label": "Logic",
      "color": "#E91E63",
      "blocks": [
        {
          "type": "logic",
          "name": "ifBlock",
          "label": "If",
          "description": "Conditional execution",
          "params": ["left", "operator", "right", "action"]
        },
        {
          "type": "logic",
          "name": "ifElseBlock",
          "label": "If / Else",
          "description": "If-else conditional",
          "params": ["left", "operator", "right", "thenAction", "elseAction"]
        },
        {
          "type": "logic",
          "name": "compareEqual",
          "label": "Compare ==",
          "description": "Check equality",
          "params": ["left", "right"]
        },
        {
          "type": "logic",
          "name": "compareNotEqual",
          "label": "Compare !=",
          "description": "Check inequality",
          "params": ["left", "right"]
        },
        {
          "type": "logic",
          "name": "compareGreater",
          "label": "Compare >",
          "description": "Greater than",
          "params": ["left", "right"]
        },
        {
          "type": "logic",
          "name": "compareLess",
          "label": "Compare <",
          "description": "Less than",
          "params": ["left", "right"]
        },
        {
          "type": "logic",
          "name": "delay",
          "label": "Delay",
          "description": "Wait then execute",
          "params": ["ms", "action"]
        },
        {
          "type": "logic",
          "name": "loop",
          "label": "Loop",
          "description": "Repeat N times",
          "params": ["count", "action"]
        }
      ]
    },
    {
      "id": "variable",
      "label": "Variables",
      "color": "#00BCD4",
      "blocks": [
        {
          "type": "variable",
          "name": "createVar",
          "label": "Create Variable",
          "description": "Declare a variable",
          "params": ["name", "type", "value"]
        },
        {
          "type": "variable",
          "name": "createVarString",
          "label": "String Var",
          "description": "String variable",
          "params": ["name", "value"]
        },
        {
          "type": "variable",
          "name": "createVarNumber",
          "label": "Number Var",
          "description": "Number variable",
          "params": ["name", "value"]
        },
        {
          "type": "variable",
          "name": "createVarBoolean",
          "label": "Boolean Var",
          "description": "Boolean variable",
          "params": ["name", "value"]
        },
        {
          "type": "variable",
          "name": "createVarColor",
          "label": "Color Var",
          "description": "Color variable",
          "params": ["name", "value"]
        },
        {
          "type": "variable",
          "name": "setVar",
          "label": "Set Variable",
          "description": "Assign a value",
          "params": ["name", "value"]
        },
        {
          "type": "variable",
          "name": "getVar",
          "label": "Get Variable",
          "description": "Read variable value",
          "params": ["name"]
        }
      ]
    }
  ],
  "pageEvents": [
    {"id": "onPageLoad", "label": "On Page Load", "description": "Runs when the page finishes loading", "icon": "load"},
    {"id": "onVisible", "label": "On Visible", "description": "Runs when page becomes visible", "icon": "visible"},
    {"id": "onHidden", "label": "On Hidden", "description": "Runs when page is hidden/background", "icon": "hidden"},
    {"id": "onDestroy", "label": "On Destroy", "description": "Runs when page is about to close", "icon": "destroy"},
    {"id": "onScroll", "label": "On Scroll", "description": "Runs when user scrolls the page", "icon": "scroll"},
    {"id": "onInput", "label": "On Input", "description": "Runs when any input changes", "icon": "input"}
  ],
  "targetSystem": {
    "modes": [
      {"id": "id", "label": "By ID", "prefix": "#", "example": "btn1"},
      {"id": "class", "label": "By Class", "prefix": ".", "example": "btn-primary"},
      {"id": "tag", "label": "By Tag", "prefix": "", "example": "button"}
    ]
  }
}
