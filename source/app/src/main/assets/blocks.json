{
  "blockCategories": [
    {
      "id": "event",
      "label": "Events",
      "color": "#FF9800",
      "blocks": [
        {
          "type": "event",
          "name": "onClick",
          "label": "On Click",
          "description": "When element is clicked",
          "target": "id",
          "params": ["elementId"]
        },
        {
          "type": "event",
          "name": "onHover",
          "label": "On Hover",
          "description": "When mouse hovers over element",
          "target": "id",
          "params": ["elementId"]
        },
        {
          "type": "event",
          "name": "onLoad",
          "label": "On Load",
          "description": "When page loads",
          "target": "tag",
          "params": ["body"]
        },
        {
          "type": "event",
          "name": "onInput",
          "label": "On Input",
          "description": "When input value changes",
          "target": "id",
          "params": ["elementId"]
        },
        {
          "type": "event",
          "name": "onSubmit",
          "label": "On Submit",
          "description": "When form is submitted",
          "target": "id",
          "params": ["formId"]
        },
        {
          "type": "event",
          "name": "onScroll",
          "label": "On Scroll",
          "description": "When user scrolls",
          "target": "tag",
          "params": ["body"]
        },
        {
          "type": "event",
          "name": "onKeyDown",
          "label": "On Key Down",
          "description": "When key is pressed",
          "target": "id",
          "params": ["elementId"]
        },
        {
          "type": "event",
          "name": "onChange",
          "label": "On Change",
          "description": "When value changes",
          "target": "id",
          "params": ["elementId"]
        }
      ]
    },
    {
      "id": "css",
      "label": "CSS Actions",
      "color": "#2196F3",
      "blocks": [
        {
          "type": "css",
          "name": "setDisplay",
          "label": "Set Display",
          "description": "block, none, flex, grid",
          "params": ["value"],
          "presets": ["block", "none", "flex", "grid", "inline-block", "inline"]
        },
        {
          "type": "css",
          "name": "setPosition",
          "label": "Set Position",
          "description": "static, relative, absolute, fixed",
          "params": ["value"],
          "presets": ["static", "relative", "absolute", "fixed", "sticky"]
        },
        {
          "type": "css",
          "name": "setOverflow",
          "label": "Set Overflow",
          "description": "hidden, scroll, auto, visible",
          "params": ["value"],
          "presets": ["hidden", "scroll", "auto", "visible"]
        },
        {
          "type": "css",
          "name": "setColor",
          "label": "Set Color",
          "description": "Set text color",
          "params": ["value"]
        },
        {
          "type": "css",
          "name": "setBackground",
          "label": "Set Background",
          "description": "Color or gradient",
          "params": ["value"]
        },
        {
          "type": "css",
          "name": "setWidth",
          "label": "Set Width",
          "description": "px, %, vw, auto",
          "params": ["value"]
        },
        {
          "type": "css",
          "name": "setHeight",
          "label": "Set Height",
          "description": "px, %, vh, auto",
          "params": ["value"]
        },
        {
          "type": "css",
          "name": "setMargin",
          "label": "Set Margin",
          "description": "Outer spacing",
          "params": ["value"]
        },
        {
          "type": "css",
          "name": "setPadding",
          "label": "Set Padding",
          "description": "Inner spacing",
          "params": ["value"]
        },
        {
          "type": "css",
          "name": "setBorder",
          "label": "Set Border",
          "description": "Border style",
          "params": ["value"]
        },
        {
          "type": "css",
          "name": "setRadius",
          "label": "Set Radius",
          "description": "Border radius",
          "params": ["value"]
        },
        {
          "type": "css",
          "name": "setOpacity",
          "label": "Set Opacity",
          "description": "0 to 1",
          "params": ["value"]
        },
        {
          "type": "css",
          "name": "setFontSize",
          "label": "Set Font Size",
          "description": "Text size",
          "params": ["value"]
        },
        {
          "type": "css",
          "name": "setTextAlign",
          "label": "Set Text Align",
          "description": "left, center, right",
          "params": ["value"],
          "presets": ["left", "center", "right", "justify"]
        },
        {
          "type": "css",
          "name": "addClass",
          "label": "Add Class",
          "description": "Add CSS class to element",
          "params": ["className"]
        },
        {
          "type": "css",
          "name": "removeClass",
          "label": "Remove Class",
          "description": "Remove CSS class",
          "params": ["className"]
        },
        {
          "type": "css",
          "name": "toggleClass",
          "label": "Toggle Class",
          "description": "Toggle CSS class",
          "params": ["className"]
        }
      ]
    },
    {
      "id": "html",
      "label": "HTML Actions",
      "color": "#4CAF50",
      "blocks": [
        {
          "type": "html",
          "name": "setHref",
          "label": "Set Href",
          "description": "URL or #section",
          "params": ["value"]
        },
        {
          "type": "html",
          "name": "scrollTo",
          "label": "Scroll To",
          "description": "id, class, or position",
          "params": ["target"],
          "presets": ["top", "bottom"]
        },
        {
          "type": "html",
          "name": "setText",
          "label": "Set Text",
          "description": "Change text content",
          "params": ["text"]
        },
        {
          "type": "html",
          "name": "setHTML",
          "label": "Set HTML",
          "description": "Set inner HTML",
          "params": ["html"]
        },
        {
          "type": "html",
          "name": "showElement",
          "label": "Show Element",
          "description": "Display element",
          "params": []
        },
        {
          "type": "html",
          "name": "hideElement",
          "label": "Hide Element",
          "description": "Hide element",
          "params": []
        },
        {
          "type": "html",
          "name": "toggleElement",
          "label": "Toggle Visible",
          "description": "Toggle show/hide",
          "params": []
        },
        {
          "type": "html",
          "name": "setAttribute",
          "label": "Set Attribute",
          "description": "Set HTML attribute",
          "params": ["attribute", "value"]
        },
        {
          "type": "html",
          "name": "removeElement",
          "label": "Remove Element",
          "description": "Remove from DOM",
          "params": ["selector"]
        },
        {
          "type": "html",
          "name": "alert",
          "label": "Show Alert",
          "description": "Browser alert dialog",
          "params": ["message"]
        },
        {
          "type": "html",
          "name": "navigate",
          "label": "Navigate",
          "description": "Go to URL",
          "params": ["url"]
        },
        {
          "type": "html",
          "name": "goToPage",
          "label": "Go To Page",
          "description": "Navigate to project page",
          "params": ["pageName"]
        }
      ]
    }
  ],
  "targetSystem": {
    "modes": [
      {"id": "id", "label": "By ID", "prefix": "#", "example": "btn1"},
      {"id": "class", "label": "By Class", "prefix": ".", "example": "btn-primary"},
      {"id": "tag", "label": "By Tag", "prefix": "", "example": "button"}
    ]
  },
  "blockStructureExample": {
    "type": "event",
    "name": "onClick",
    "target": "id",
    "value": "btn1",
    "actions": [
      {
        "type": "css",
        "name": "setDisplay",
        "value": "none"
      }
    ]
  },
  "jsOutputExample": "document.getElementById('btn1').style.display = 'none';"
}
