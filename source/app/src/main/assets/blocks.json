        {"type": "css", "name": "setGap", "label": "Gap", "description": "row/column gap", "params": ["value"]},
        {"type": "css", "name": "setOverflow", "label": "Overflow", "description": "hidden/scroll/auto", "params": ["value"]},
        {"type": "css", "name": "setTransform", "label": "Transform", "description": "rotate/scale/translate", "params": ["value"]},
        {"type": "css", "name": "setTransition", "label": "Transition", "description": "property duration ease", "params": ["value"]},
        {"type": "css", "name": "addClass", "label": "Add Class", "description": "Append class", "params": ["className"]},
        {"type": "css", "name": "removeClass", "label": "Remove Class", "description": "Remove class", "params": ["className"]},
        {"type": "css", "name": "toggleClass", "label": "Toggle Class", "description": "Toggle class", "params": ["className"]}
      ]
    },
    {
      "id": "html",
      "label": "HTML Attributes",
      "color": "#4CAF50",
      "blocks": [
        {"type": "html", "name": "setHref", "label": "Href", "description": "Links and anchors", "params": ["value"]},
        {"type": "html", "name": "setSrc", "label": "Src", "description": "Images/media source", "params": ["value"]},
        {"type": "html", "name": "setId", "label": "ID", "description": "Element id", "params": ["value"]},
        {"type": "html", "name": "setClassAttr", "label": "Class", "description": "Class attribute", "params": ["value"]},
        {"type": "html", "name": "setAlt", "label": "Alt", "description": "Alt text", "params": ["value"]},
        {"type": "html", "name": "setTitle", "label": "Title", "description": "Title attribute", "params": ["value"]},
        {"type": "html", "name": "setAriaLabel", "label": "aria-label", "description": "Accessibility label", "params": ["value"]},
        {"type": "html", "name": "setAttribute", "label": "Custom Attribute", "description": "attr:value", "params": ["attribute","value"]}
