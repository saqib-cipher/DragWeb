        {"type": "css", "name": "setMargin", "label": "Margin", "description": "Outer spacing", "params": ["value"]},
        {"type": "css", "name": "setPadding", "label": "Padding", "description": "Inner spacing", "params": ["value"]},
        {"type": "css", "name": "setBorder", "label": "Border", "description": "Border shorthand", "params": ["value"]},
        {"type": "css", "name": "setRadius", "label": "Radius", "description": "Border radius", "params": ["value"]},
        {"type": "css", "name": "setOpacity", "label": "Opacity", "description": "0-1", "params": ["value"]},
        {"type": "css", "name": "setFontSize", "label": "Font Size", "description": "Text size", "params": ["value"]},
        {"type": "css", "name": "setTextAlign", "label": "Text Align", "description": "left/center/right", "params": ["value"], "presets": ["left","center","right","justify"]},
        {"type": "css", "name": "setFlex", "label": "Flex", "description": "display:flex + props", "params": ["value"]},
