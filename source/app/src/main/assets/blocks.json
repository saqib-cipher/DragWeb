{
  "blockCategories": [
    {
      "id": "event",
      "label": "Events",
      "color": "#FF9800",
      "blocks": [
        {
          "type": "event",
          "name": "onVisible",
          "label": "On Visible",
          "description": "When page becomes visible",
          "target": "tag",
          "params": ["body"]
        },
        {
          "type": "event",
          "name": "onHidden",
          "label": "On Hidden",
          "description": "When page is hidden",
          "target": "tag",
          "params": ["body"]
        },
        {
          "type": "event",
          "name": "onDestroy",
          "label": "On Destroy",
          "description": "When page is about to unload",
          "target": "tag",
          "params": ["body"]
        },
        {
          "type": "event",
          "name": "onScroll",
          "label": "On Scroll",
          "description": "When user scrolls the page",
          "target": "tag",
          "params": ["body"]
        },
        {
          "type": "event",
          "name": "onInput",
          "label": "On Input",
          "description": "When input value changes",
          "target": "id",
          "params": ["elementId"]
        },
        {
          "type": "event",
          "name": "onSubmit",
          "label": "On Submit",
          "description": "When form is submitted",
          "target": "id",
          "params": ["formId"]
        },
        {
          "type": "event",
          "name": "onKeyDown",
          "label": "On Key Down",
          "description": "When key is pressed",
          "target": "id",
          "params": ["elementId"]
        },
        {
          "type": "event",
          "name": "onChange",
          "label": "On Change",
          "description": "When value changes",
          "target": "id",
          "params": ["elementId"]
        }
      ]
    },
    {
      "id": "css",
      "label": "CSS Styles",
      "color": "#2196F3",
      "blocks": [
        {
          "type": "css",
          "name": "setDisplay",
          "label": "Set Display",
          "description": "block, none, flex, grid",
          "params": ["value"],
          "presets": ["block", "none", "flex", "grid", "inline-block", "inline"]
        },
        {
          "type": "css",
          "name": "setPosition",
          "label": "Set Position",
          "description": "static, relative, absolute, fixed",
          "params": ["value"],
          "presets": ["static", "relative", "absolute", "fixed", "sticky"]
        },
        {
          "type": "css",
          "name": "setOverflow",
          "label": "Set Overflow",
          "description": "hidden, scroll, auto, visible",
          "params": ["value"],
          "presets": ["hidden", "scroll", "auto", "visible"]
        },
        {
          "type": "css",
          "name": "setColor",
          "label": "Set Color",
          "description": "Set text color",
          "params": ["value"]
        },
        {
          "type": "css",
          "name": "setBackground",
          "label": "Set Background",
          "description": "Color or gradient",
          "params": ["value"]
        },
        {
          "type": "css",
          "name": "setWidth",
          "label": "Set Width",
          "description": "px, %, vw, auto",
          "params": ["value"]
        },
        {
          "type": "css",
          "name": "setHeight",
          "label": "Set Height",
          "description": "px, %, vh, auto",
          "params": ["value"]
        },
        {
          "type": "css",
          "name": "setMargin",
          "label": "Set Margin",
          "description": "Outer spacing",
          "params": ["value"]
        },
        {
          "type": "css",
          "name": "setPadding",
          "label": "Set Padding",
          "description": "Inner spacing",
          "params": ["value"]
        },
        {
          "type": "css",
          "name": "setBorder",
          "label": "Set Border",
          "description": "Border style",
          "params": ["value"]
        },
        {
          "type": "css",
          "name": "setRadius",
          "label": "Set Radius",
          "description": "Border radius",
          "params": ["value"]
        },
        {
          "type": "css",
          "name": "setOpacity",
          "label": "Set Opacity",
          "description": "0 to 1",
          "params": ["value"]
        },
        {
          "type": "css",
          "name": "setFontSize",
          "label": "Set Font Size",
          "description": "Text size",
          "params": ["value"]
        },
        {
          "type": "css",
          "name": "setFontWeight",
          "label": "Font Weight",
          "description": "bold, normal, lighter",
          "params": ["value"],
          "presets": ["normal", "bold", "lighter", "bolder", "100", "400", "700", "900"]
        },
        {
          "type": "css",
          "name": "setTextAlign",
          "label": "Set Text Align",
          "description": "left, center, right",
          "params": ["value"],
          "presets": ["left", "center", "right", "justify"]
        },
        {
          "type": "css",
          "name": "setLineHeight",
          "label": "Line Height",
          "description": "Text line height",
          "params": ["value"]
        },
        {
          "type": "css",
          "name": "setZIndex",
          "label": "Set Z-Index",
          "description": "Stack order",
          "params": ["value"]
        },
        {
          "type": "css",
          "name": "setFlex",
          "label": "Set Flex",
          "description": "Flex shorthand value",
          "params": ["value"]
        },
        {
          "type": "css",
          "name": "setFlexDirection",
          "label": "Flex Direction",
          "description": "row, column, row-reverse",
          "params": ["value"],
          "presets": ["row", "column", "row-reverse", "column-reverse"]
        },
        {
          "type": "css",
          "name": "setJustifyContent",
          "label": "Justify Content",
          "description": "Main axis alignment",
          "params": ["value"],
          "presets": ["flex-start", "flex-end", "center", "space-between", "space-around", "space-evenly"]
        },
        {
          "type": "css",
          "name": "setAlignItems",
          "label": "Align Items",
          "description": "Cross axis alignment",
          "params": ["value"],
          "presets": ["flex-start", "flex-end", "center", "stretch", "baseline"]
        },
        {
          "type": "css",
          "name": "setGap",
          "label": "Set Gap",
          "description": "Space between flex/grid items",
          "params": ["value"]
        },
        {
          "type": "css",
          "name": "setGrid",
          "label": "Set Grid",
          "description": "Grid template columns",
          "params": ["value"]
        },
        {
          "type": "css",
          "name": "setBoxShadow",
          "label": "Box Shadow",
          "description": "Element shadow",
          "params": ["value"]
        },
        {
          "type": "css",
          "name": "setTransform",
          "label": "Set Transform",
          "description": "rotate, scale, translate",
          "params": ["value"]
        },
        {
          "type": "css",
          "name": "setTransition",
          "label": "Set Transition",
          "description": "CSS transition animation",
          "params": ["value"]
        },
        {
          "type": "css",
          "name": "setCursor",
          "label": "Set Cursor",
          "description": "Mouse cursor style",
          "params": ["value"],
          "presets": ["pointer", "default", "text", "not-allowed", "grab", "grabbing", "crosshair"]
        },
        {
          "type": "css",
          "name": "addClass",
          "label": "Add Class",
          "description": "Add CSS class to element",
          "params": ["className"]
        },
        {
          "type": "css",
          "name": "removeClass",
          "label": "Remove Class",
          "description": "Remove CSS class",
          "params": ["className"]
        },
        {
          "type": "css",
          "name": "toggleClass",
          "label": "Toggle Class",
          "description": "Toggle CSS class",
          "params": ["className"]
        }
      ]
    },
    {
      "id": "css_pseudo",
      "label": "CSS Interactions",
      "color": "#9C27B0",
      "description": "CSS pseudo-class styles applied directly in the stylesheet (no JavaScript needed)",
      "blocks": [
        {
          "type": "css_pseudo",
          "name": "setHoverStyle",
          "label": "Hover Style",
          "description": "Style applied on :hover (CSS only)",
          "params": ["property", "value"],
          "pseudoClass": "hover"
        },
        {
          "type": "css_pseudo",
          "name": "setFocusStyle",
          "label": "Focus Style",
          "description": "Style applied on :focus (CSS only)",
          "params": ["property", "value"],
          "pseudoClass": "focus"
        },
        {
          "type": "css_pseudo",
          "name": "setActiveStyle",
          "label": "Active Style",
          "description": "Style applied on :active press (CSS only)",
          "params": ["property", "value"],
          "pseudoClass": "active"
        },
        {
          "type": "css_pseudo",
          "name": "setVisitedStyle",
          "label": "Visited Style",
          "description": "Style for visited links (:visited)",
          "params": ["property", "value"],
          "pseudoClass": "visited"
        },
        {
          "type": "css_pseudo",
          "name": "setCheckedStyle",
          "label": "Checked Style",
          "description": "Style for checked inputs (:checked)",
          "params": ["property", "value"],
          "pseudoClass": "checked"
        },
        {
          "type": "css_pseudo",
          "name": "setDisabledStyle",
          "label": "Disabled Style",
          "description": "Style for disabled elements (:disabled)",
          "params": ["property", "value"],
          "pseudoClass": "disabled"
        },
        {
          "type": "css_pseudo",
          "name": "setPlaceholderStyle",
          "label": "Placeholder Style",
          "description": "Style for input placeholder (::placeholder)",
          "params": ["property", "value"],
          "pseudoClass": "placeholder"
        }
      ]
    },
    {
      "id": "html",
      "label": "HTML Attributes",
      "color": "#4CAF50",
      "blocks": [
        {
          "type": "html",
          "name": "setId",
          "label": "Set ID",
          "description": "Set element id attribute",
          "params": ["value"]
        },
        {
          "type": "html",
          "name": "setClass",
          "label": "Set Class",
          "description": "Set element class attribute",
          "params": ["value"]
        },
        {
          "type": "html",
          "name": "setHref",
          "label": "Set Href",
          "description": "URL or #section for links",
          "params": ["value"]
        },
        {
          "type": "html",
          "name": "setTarget",
          "label": "Set Target",
          "description": "Link target attribute",
          "params": ["value"],
          "presets": ["_blank", "_self", "_parent", "_top"]
        },
        {
          "type": "html",
          "name": "setSrc",
          "label": "Set Src",
          "description": "Image or media source path",
          "params": ["value"]
        },
        {
          "type": "html",
          "name": "setAlt",
          "label": "Set Alt",
          "description": "Image alt text",
          "params": ["value"]
        },
        {
          "type": "html",
          "name": "setPlaceholder",
          "label": "Set Placeholder",
          "description": "Input placeholder text",
          "params": ["value"]
        },
        {
          "type": "html",
          "name": "setValue",
          "label": "Set Value",
          "description": "Input or select value",
          "params": ["value"]
        },
        {
          "type": "html",
          "name": "setDisabled",
          "label": "Set Disabled",
          "description": "Disable or enable element",
          "params": ["value"],
          "presets": ["true", "false"]
        },
        {
          "type": "html",
          "name": "setChecked",
          "label": "Set Checked",
          "description": "Checkbox checked state",
          "params": ["value"],
          "presets": ["true", "false"]
        },
        {
          "type": "html",
          "name": "setAttribute",
          "label": "Set Attribute",
